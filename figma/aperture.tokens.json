  },

  "typography": {
    "_comment": "Composite TEXT STYLES (Figma can't put font-family in a number var). Note the tight NEGATIVE tracking on display + positive tracking + UPPERCASE on eyebrows/headers.",
    "body":         { "value": { "fontFamily": "Inter", "fontWeight": "Regular", "fontSize": "12", "letterSpacing": "0%" }, "type": "typography" },
    "label":        { "value": { "fontFamily": "Inter", "fontWeight": "Semi Bold", "fontSize": "13", "letterSpacing": "0%" }, "type": "typography", "description": "tab labels" },
    "eyebrow-upper":{ "value": { "fontFamily": "Inter", "fontWeight": "Bold", "fontSize": "9", "letterSpacing": "14%", "textCase": "uppercase" }, "type": "typography" },
    "data":         { "value": { "fontFamily": "JetBrains Mono", "fontWeight": "Bold", "fontSize": "12", "letterSpacing": "0%" }, "type": "typography", "description": "price / data cells" },
    "cell-upper":   { "value": { "fontFamily": "JetBrains Mono", "fontWeight": "Bold", "fontSize": "10", "letterSpacing": "10%", "textCase": "uppercase" }, "type": "typography", "description": "table column headers" },
    "display":      { "value": { "fontFamily": "Inter", "fontWeight": "Medium", "fontSize": "79", "letterSpacing": "-5.5%", "lineHeight": "83.6" }, "type": "typography", "description": "hero price — tight negative tracking" }
  },

  "shadow": {
    "_comment": "EFFECT STYLES (not variables).",
    "card":  { "value": { "x": "0", "y": "10", "blur": "30", "spread": "0", "color": "rgba(0,0,0,0.4)", "type": "dropShadow" }, "type": "boxShadow", "description": "96×96 round cards" },
    "modal": { "value": { "x": "0", "y": "30", "blur": "80", "spread": "0", "color": "rgba(0,0,0,0.6)", "type": "dropShadow" }, "type": "boxShadow", "description": "overlays / modals" }
  }
