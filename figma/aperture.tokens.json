  "fontFamily": {
    "ui":      { "value": "Inter",          "type": "fontFamilies", "description": "all textual UI + display numbers" },
    "mono":    { "value": "JetBrains Mono",  "type": "fontFamilies", "description": "EVERY numeric / price / table cell" }
  },

  "fontSize": {
    "_comment": "Number variables. The `display/*` ramp is the giant chart price headline.",
    "2xs":         { "value": "9",   "type": "fontSizes", "description": "eyebrow labels" },
    "xs":          { "value": "10",  "type": "fontSizes", "description": "table cells, column headers" },
    "sm":          { "value": "12",  "type": "fontSizes", "description": "data values, body" },
    "md":          { "value": "13",  "type": "fontSizes", "description": "default UI / tab labels" },
    "lg":          { "value": "16",  "type": "fontSizes" },
    "xl":          { "value": "22",  "type": "fontSizes", "description": "card values (sentiment / intraday)" },
