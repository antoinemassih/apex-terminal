{
  "name": "cancel_orders_clear_history_housekeeping",
  "description": "Trader performs safe desk housekeeping: cancels all orders and clears order history.",
  "story": "Alerts/Housekeeping",
  "tags": [
    "story",
    "alerts",
    "housekeeping",
    "orders",
    "safe"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
