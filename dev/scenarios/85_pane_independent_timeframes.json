{
  "name": "85_pane_independent_timeframes",
  "description": "Verify that panes maintain independent timeframes in TwoColumns layout: pane0=SPY 1h, pane1=QQQ 5m.",
  "story": "Layout/Panes",
  "tags": ["pane", "timeframe"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "TwoColumns" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "pane_count_equals": 2 } ] },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "SPY" } },
    { "action": "cmd", "cmd": "ChangeTimeframe", "args": { "pane": 0, "tf": "1h" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 1, "symbol": "QQQ" } },
    { "action": "cmd", "cmd": "ChangeTimeframe", "args": { "pane": 1, "tf": "5m" } },
    { "action": "wait_frames", "count": 8 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "no_active_violations": true },
      { "no_clipped_widgets": true }
    ] },
    { "action": "snapshot", "name": "independent_timeframes" }
  ]
}
