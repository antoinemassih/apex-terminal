{
  "name": "reset_iso_dom_tsla",
  "description": "After driving dom on TSLA, reset returns a clean baseline (no contamination).",
  "story": "Harness/ResetIsolation",
  "tags": [
    "harness",
    "reset",
    "isolation"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "TSLA"
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SetDomSidebar",
      "pane": 0,
      "open": true
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "drive dom then reset TSLA"
    },
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "panes.0.dom_sidebar_open",
            "value": false
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        }
      ]
    }
  ]
}