{
  "name": "story_support_resistance",
  "description": "Full support/resistance workflow: viewport + two levels + anchor verification",
  "story": "Canvas Introspection",
  "priority": 1,
  "tags": [
    "canvas",
    "story",
    "smoke"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "cmd",
      "cmd": "SetViewport",
      "pane": 0,
      "price_low": 420,
      "price_high": 480
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "support",
      "kind": "HorizLine",
      "price_a": 435
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "resistance",
      "kind": "HorizLine",
      "price_a": 465
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_drawing_count_equals": {
            "pane": 0,
            "count": 2
          }
        },
        {
          "canvas_drawing_exists": {
            "pane": 0,
            "id": "support"
          }
        },
        {
          "canvas_drawing_exists": {
            "pane": 0,
            "id": "resistance"
          }
        },
        {
          "canvas_drawing_anchor_price_near": {
            "pane": 0,
            "id": "support",
            "anchor": 0,
            "price": 435,
            "tolerance": 0.01
          }
        },
        {
          "canvas_drawing_anchor_price_near": {
            "pane": 0,
            "id": "resistance",
            "anchor": 0,
            "price": 465,
            "tolerance": 0.01
          }
        },
        {
          "canvas_viewport_price_contains": {
            "pane": 0,
            "price": 435
          }
        },
        {
          "canvas_viewport_price_contains": {
            "pane": 0,
            "price": 465
          }
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        }
      ]
    }
  ]
}
