{
  "name": "indicator_per_pane_isolated",
  "description": "TwoColumns: add RSI to pane 0 only. Assert pane 1 still has 0 indicators.",
  "story": "Indicator/Lifecycle",
  "tags": [
    "indicator",
    "pane",
    "isolation"
  ],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "cmd",
      "cmd": "SetLayout",
      "args": {
        "layout": "TwoColumns"
      }
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "args": {
        "pane": 0,
        "kind": "RSI"
      }
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "indicator_count_equals": {
            "pane": 0,
            "count": 1
          }
        },
        {
          "indicator_count_equals": {
            "pane": 1,
            "count": 0
          }
        },
        {
          "fps_above": 5
        }
      ]
    },
    {
      "action": "reset"
    }
  ]
}
