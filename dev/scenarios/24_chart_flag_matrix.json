{
  "name": "chart_flag_matrix",
  "description": "User story: as a trader I toggle volume, log scale, oscillator visibility, and other display options independently. Each toggle should leave the chart stable with no contract violations.",
  "tags": ["flags", "display", "design"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 2 },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "ShowVolume", "value": false } },
    { "action": "wait_frames", "count": 2 },
    {
      "action": "assert",
      "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }]
    },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "ShowVolume", "value": true } },
    { "action": "wait_frames", "count": 2 },
    {
      "action": "assert",
      "assertions": [{ "fps_above": 5.0 }]
    },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "LogScale", "value": true } },
    { "action": "wait_frames", "count": 2 },
    {
      "action": "assert",
      "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }]
    },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "LogScale", "value": false } },
    { "action": "wait_frames", "count": 2 },
    {
      "action": "assert",
      "assertions": [{ "fps_above": 5.0 }]
    },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "OhlcTooltip", "value": true } },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "Magnet", "value": true } },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "ShowOscillators", "value": true } },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }]
    },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "HideAllIndicators", "value": true } },
    { "action": "wait_frames", "count": 2 },
    {
      "action": "assert",
      "assertions": [{ "fps_above": 5.0 }]
    },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "HideAllIndicators", "value": false } },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "ShowPrevClose", "value": true } },
    { "action": "wait_frames", "count": 2 },
    {
      "action": "assert",
      "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }]
    },
    { "action": "log", "message": "Chart flag matrix complete — ShowVolume/LogScale/OhlcTooltip/Magnet/ShowOscillators/HideAllIndicators/ShowPrevClose all toggled without violations." }
  ]
}
