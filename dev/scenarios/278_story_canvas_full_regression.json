{
  "name": "story_canvas_full_regression",
  "description": "Smoke regression: every canvas assertion type exercised in one pass",
  "story": "Canvas Introspection",
  "priority": 1,
  "tags": [
    "canvas",
    "story",
    "smoke",
    "regression"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait",
      "ms": 50
    },
    {
      "action": "cmd",
      "cmd": "SetViewport",
      "pane": 0,
      "price_low": 400,
      "price_high": 500
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "h1",
      "kind": "HorizLine",
      "price_a": 430
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "zone",
      "kind": "HorizZone",
      "price_a": 440,
      "price_b": 460
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "trend",
      "kind": "Trendline",
      "price_a": 435,
      "price_b": 455
    },
    {
      "action": "cmd",
      "cmd": "SetIndicatorOutput",
      "pane": 0,
      "kind": "SMA",
      "value": 449
    },
    {
      "action": "cmd",
      "cmd": "SetIndicatorOutput",
      "pane": 0,
      "kind": "RSI",
      "value": 55
    },
    {
      "action": "wait",
      "ms": 50
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_pane_count_equals": 1
        },
        {
          "canvas_drawing_count_equals": {
            "pane": 0,
            "count": 3
          }
        },
        {
          "canvas_drawing_exists": {
            "pane": 0,
            "id": "h1"
          }
        },
        {
          "canvas_drawing_not_exists": {
            "pane": 0,
            "id": "nonexistent"
          }
        },
        {
          "canvas_drawing_kind_count": {
            "pane": 0,
            "kind": "HorizLine",
            "count": 1
          }
        },
        {
          "canvas_drawing_anchor_count": {
            "pane": 0,
            "id": "h1",
            "count": 1
          }
        },
        {
          "canvas_drawing_anchor_count": {
            "pane": 0,
            "id": "trend",
            "count": 2
          }
        },
        {
          "canvas_drawing_anchor_price_near": {
            "pane": 0,
            "id": "h1",
            "anchor": 0,
            "price": 430,
            "tolerance": 0.01
          }
        },
        {
          "canvas_viewport_price_contains": {
            "pane": 0,
            "price": 450
          }
        },
        {
          "canvas_viewport_px_per_bar_gte": {
            "pane": 0,
            "min": 1
          }
        },
        {
          "canvas_indicator_exists": {
            "pane": 0,
            "kind": "SMA"
          }
        },
        {
          "canvas_indicator_exists": {
            "pane": 0,
            "kind": "RSI"
          }
        },
        {
          "canvas_indicator_count_equals": {
            "pane": 0,
            "count": 2
          }
        },
        {
          "canvas_indicator_value_in_range": {
            "pane": 0,
            "kind": "SMA",
            "min": 440,
            "max": 460
          }
        },
        {
          "canvas_indicator_last_value_near": {
            "pane": 0,
            "kind": "SMA",
            "value": 449,
            "tolerance": 0.01
          }
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "canvas_visible_bar_count_gte": {
            "pane": 0,
            "min": 1
          }
        },
        {
          "canvas_bar_volume_gte": {
            "pane": 0,
            "min": 0
          }
        }
      ]
    }
  ]
}
