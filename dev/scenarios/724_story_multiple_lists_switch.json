{
  "name": "story_multiple_lists_switch",
  "description": "Trader creates two named watchlists and switches the active list back and forth.",
  "story": "Watchlist/MultiList",
  "tags": [
    "story",
    "watchlist",
    "multilist"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "Create multiple named lists and switch between them"
    },
    {
      "action": "cmd",
      "cmd": "WatchlistCreate",
      "name": "Tech Leaders"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "AAPL"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "MSFT"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistCreate",
      "name": "ETF Macro"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "SPY"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "QQQ"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "fps_above": 5.0
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "WatchlistSwitchActive",
      "idx": 0
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "fps_above": 5.0
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "WatchlistSwitchActive",
      "idx": 1
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}