{
  "name": "canvas_trendline_anchors",
  "description": "Trendline has two anchors at the specified prices",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": [
    "canvas",
    "drawings",
    "anchors"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "trend1",
      "kind": "Trendline",
      "price_a": 440,
      "price_b": 460
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_drawing_exists": {
            "pane": 0,
            "id": "trend1"
          }
        },
        {
          "canvas_drawing_anchor_count": {
            "pane": 0,
            "id": "trend1",
            "count": 2
          }
        },
        {
          "canvas_drawing_anchor_price_near": {
            "pane": 0,
            "id": "trend1",
            "anchor": 0,
            "price": 440,
            "tolerance": 0.01
          }
        },
        {
          "canvas_drawing_anchor_price_near": {
            "pane": 0,
            "id": "trend1",
            "anchor": 1,
            "price": 460,
            "tolerance": 0.01
          }
        }
      ]
    }
  ]
}
