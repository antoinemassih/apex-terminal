{
  "name": "canvas_drawing_lifecycle",
  "description": "Full drawing lifecycle: add two drawings then clear all at once",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": ["canvas", "drawings"],
  "steps": [
    {"action": "reset"},
    {"action": "wait", "ms": 30},
    {"action": "cmd", "cmd": "AddDrawing", "pane": 0,
     "id": "d1", "kind": "HorizLine", "price_a": 452.0},
    {"action": "cmd", "cmd": "AddDrawing", "pane": 0,
     "id": "d2", "kind": "Trendline", "price_a": 448.0, "price_b": 458.0},
    {"action": "wait", "ms": 30},
    {"action": "assert", "assertions": [
      {"canvas_drawing_count_equals": {"pane": 0, "count": 2}},
      {"canvas_drawing_exists":       {"pane": 0, "id": "d1"}},
      {"canvas_drawing_exists":       {"pane": 0, "id": "d2"}},
      {"canvas_drawing_kind_count":   {"pane": 0, "kind": "HorizLine",  "count": 1}},
      {"canvas_drawing_kind_count":   {"pane": 0, "kind": "Trendline", "count": 1}}
    ]},
    {"action": "cmd", "cmd": "ClearDrawings", "pane": 0},
    {"action": "wait", "ms": 30},
    {"action": "assert", "assertions": [
      {"canvas_no_drawings":          {"pane": 0}},
      {"canvas_drawing_count_equals": {"pane": 0, "count": 0}}
    ]}
  ]
}
