{
  "name": "chart_flags",
  "description": "Toggle chart display flags (volume, log scale) and verify no crash.",
  "tags": ["smoke", "commands"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "SetChartFlag",
      "pane": 0,
      "flag": "ShowVolume",
      "value": false
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "assert",
      "assertions": [
        { "fps_above": 5.0 },
        { "no_open_dialogs": true }
      ]
    },
    {
      "action": "cmd",
      "cmd": "SetChartFlag",
      "pane": 0,
      "flag": "ShowVolume",
      "value": true
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "SetChartFlag",
      "pane": 0,
      "flag": "LogScale",
      "value": true
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "SetChartFlag",
      "pane": 0,
      "flag": "LogScale",
      "value": false
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "assert",
      "assertions": [
        { "fps_above": 5.0 },
        { "no_active_violations": true }
      ]
    },
    {
      "action": "log",
      "message": "Chart flag toggle scenario passed."
    }
  ]
}
