{
  "name": "stress_combined_state",
  "description": "Add indicators, open a dialog, and add watchlist sections simultaneously. Verify combined state, then reset and assert all state is clean.",
  "story": "StressTest/Combined",
  "tags": ["stress-test", "combined", "reset", "dialogs", "indicators", "watchlist"],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "RSI" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "MACD" } },
    { "action": "cmd", "cmd": "OpenSettings", "args": {} },
    { "action": "cmd", "cmd": "WatchlistAddSection", "args": { "title": "Alpha" } },
    { "action": "cmd", "cmd": "WatchlistAddSection", "args": { "title": "Beta" } },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "indicator_count_equals": { "pane": 0, "count": 2 } },
        { "dialog_open": "settings" },
        { "watchlist_section_count_equals": 3 }
      ]
    },
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    {
      "action": "assert",
      "assertions": [
        { "indicator_count_equals": { "pane": 0, "count": 0 } },
        { "no_open_dialogs": true },
        { "watchlist_section_count_equals": 1 },
        { "pane_count_equals": 1 },
        { "fps_above": 5.0 }
      ]
    }
  ]
}
