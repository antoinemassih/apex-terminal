{
  "name": "canvas_full_story",
  "description": "Complete canvas workflow: viewport, drawings, indicator, bars — all assertions combined",
  "story": "Canvas Introspection",
  "priority": 1,
  "tags": ["canvas", "story", "smoke"],
  "steps": [
    {"action": "reset"},
    {"action": "wait", "ms": 50},

    {"action": "cmd", "cmd": "SetViewport", "pane": 0,
     "price_low": 420.0, "price_high": 480.0},
    {"action": "wait", "ms": 30},
    {"action": "assert", "assertions": [
      {"canvas_pane_count_equals":        1},
      {"canvas_viewport_price_contains":  {"pane": 0, "price": 450.0}},
      {"canvas_viewport_px_per_bar_gte":  {"pane": 0, "min": 1.0}},
      {"canvas_bar_ohlc_valid":           {"pane": 0}},
      {"canvas_visible_bar_count_gte":    {"pane": 0, "min": 1}},
      {"canvas_no_drawings":              {"pane": 0}}
    ]},

    {"action": "cmd", "cmd": "AddDrawing", "pane": 0,
     "id": "support", "kind": "HorizLine", "price_a": 435.0},
    {"action": "cmd", "cmd": "AddDrawing", "pane": 0,
     "id": "resist",  "kind": "HorizLine", "price_a": 465.0},
    {"action": "cmd", "cmd": "SetIndicatorOutput", "pane": 0, "kind": "SMA", "value": 449.0},
    {"action": "wait", "ms": 30},
    {"action": "assert", "assertions": [
      {"canvas_drawing_count_equals":      {"pane": 0, "count": 2}},
      {"canvas_drawing_exists":            {"pane": 0, "id": "support"}},
      {"canvas_drawing_exists":            {"pane": 0, "id": "resist"}},
      {"canvas_drawing_kind_count":        {"pane": 0, "kind": "HorizLine", "count": 2}},
      {"canvas_drawing_anchor_price_near": {"pane": 0, "id": "support", "anchor": 0, "price": 435.0, "tolerance": 0.01}},
      {"canvas_drawing_anchor_price_near": {"pane": 0, "id": "resist",  "anchor": 0, "price": 465.0, "tolerance": 0.01}},
      {"canvas_indicator_value_in_range":  {"pane": 0, "kind": "SMA", "min": 420.0, "max": 480.0}},
      {"canvas_indicator_last_value_near": {"pane": 0, "kind": "SMA", "value": 449.0, "tolerance": 0.01}}
    ]},

    {"action": "cmd", "cmd": "RemoveDrawing", "pane": 0, "id": "support"},
    {"action": "wait", "ms": 30},
    {"action": "assert", "assertions": [
      {"canvas_drawing_count_equals": {"pane": 0, "count": 1}},
      {"canvas_drawing_exists":       {"pane": 0, "id": "resist"}}
    ]},

    {"action": "reset"},
    {"action": "wait", "ms": 50},
    {"action": "assert", "assertions": [
      {"canvas_no_drawings": {"pane": 0}},
      {"canvas_pane_count_equals": 1}
    ]}
  ]
}
