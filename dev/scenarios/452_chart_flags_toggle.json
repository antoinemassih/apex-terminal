{
  "name": "chart_flags_toggle",
  "description": "Toggle ShowVolume, LogScale, Magnet, OhlcTooltip, and HideAllIndicators flags on and off. Verify no crashes or violations.",
  "story": "ChartFlags/Toggle",
  "tags": ["chart", "flags", "settings"],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "log", "message": "Enable ShowVolume" },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "ShowVolume", "value": true } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "log", "message": "Disable ShowVolume" },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "ShowVolume", "value": false } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "log", "message": "Enable LogScale" },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "LogScale", "value": true } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "log", "message": "Disable LogScale" },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "LogScale", "value": false } },
    { "action": "wait_frames", "count": 2 },
    { "action": "log", "message": "Toggle Magnet on then off" },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "Magnet", "value": true } },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "Magnet", "value": false } },
    { "action": "wait_frames", "count": 2 },
    { "action": "log", "message": "Enable OhlcTooltip" },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "OhlcTooltip", "value": true } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "OhlcTooltip", "value": false } },
    { "action": "log", "message": "HideAllIndicators then show again" },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "HideAllIndicators", "value": true } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "HideAllIndicators", "value": false } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "reset" }
  ]
}
