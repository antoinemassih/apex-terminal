{
  "name": "canvas_indicator_output",
  "description": "Set indicator output and verify value_in_range assertion",
  "story": "Canvas Introspection",
  "priority": 1,
  "tags": ["canvas", "indicators"],
  "steps": [
    {"action": "reset"},
    {"action": "wait", "ms": 30},
    {"action": "cmd", "cmd": "SetIndicatorOutput", "pane": 0,
     "kind": "RSI", "value": 67.5},
    {"action": "wait", "ms": 30},
    {"action": "assert", "assertions": [
      {"canvas_indicator_value_in_range": {"pane": 0, "kind": "RSI", "min": 0.0, "max": 100.0}},
      {"canvas_indicator_value_in_range": {"pane": 0, "kind": "RSI", "min": 60.0, "max": 80.0}}
    ]}
  ]
}
