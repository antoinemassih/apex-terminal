      "symbol": "SPY"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "SetChartFlag",
      "pane": 0,
      "flag": "ShowStrikesOverlay",
      "value": true
