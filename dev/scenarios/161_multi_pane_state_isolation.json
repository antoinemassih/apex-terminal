{
  "name": "multi_pane_state_isolation",
  "description": "After SetLayout TwoColumns, each pane tracks its own symbol/timeframe/indicators independently. Mutations on pane 0 must not bleed into pane 1 and vice versa.",
  "tags": ["multi-pane", "state-isolation", "regression"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "TwoColumns" } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [
      { "pane_count_equals": 2 }
    ]},
    { "action": "log", "message": "Setting pane 0 to SPY/1m with 2 indicators" },
    { "action": "cmd", "cmd": "SwapPaneSymbol",  "args": { "pane": 0, "symbol": "SPY" } },
    { "action": "cmd", "cmd": "ChangeTimeframe", "args": { "pane": 0, "tf": "1m" } },
    { "action": "cmd", "cmd": "AddIndicator",    "args": { "pane": 0, "kind": "RSI" } },
    { "action": "cmd", "cmd": "AddIndicator",    "args": { "pane": 0, "kind": "MACD" } },
    { "action": "log", "message": "Setting pane 1 to QQQ/5m with 1 indicator" },
    { "action": "cmd", "cmd": "SwapPaneSymbol",  "args": { "pane": 1, "symbol": "QQQ" } },
    { "action": "cmd", "cmd": "ChangeTimeframe", "args": { "pane": 1, "tf": "5m" } },
    { "action": "cmd", "cmd": "AddIndicator",    "args": { "pane": 1, "kind": "VWAP" } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [
      { "pane_symbol_equals":    { "pane": 0, "symbol": "SPY" } },
      { "pane_timeframe_equals": { "pane": 0, "timeframe": "1m" } },
      { "pane_symbol_equals":    { "pane": 1, "symbol": "QQQ" } },
      { "pane_timeframe_equals": { "pane": 1, "timeframe": "5m" } }
    ]},
    { "action": "log", "message": "Removing indicator on pane 1 — pane 0 must stay at 2" },
    { "action": "cmd", "cmd": "RemoveIndicator", "args": { "pane": 1, "kind": "VWAP" } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [
      { "state_field_gte": { "path": "panes.0.indicator_count", "min": 2 } },
      { "state_field_lte": { "path": "panes.0.indicator_count", "max": 2 } },
      { "state_field_lte": { "path": "panes.1.indicator_count", "max": 0 } },
      { "fps_above": 5.0 }
    ]},
    { "action": "log", "message": "Pane state isolation verified" }
  ]
}
