{
  "name": "story_watchlist_option_section",
  "description": "Trader adds an options section to the watchlist.",
  "story": "Watchlist/Sections",
  "tags": [
    "story",
    "watchlist",
    "options"
  ],
  "priority": 2,
  "settle_ms": 15,
