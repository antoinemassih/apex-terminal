{
  "name": "canvas_ohlc_valid_after_tf_change",
  "description": "Change from 5m to 1h timeframe: bars remain valid OHLC.",
  "story": "Canvas/Integrity",
  "tags": [
    "canvas",
    "bars",
    "timeframe"
  ],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "args": {
        "pane": 0,
        "symbol": "SPY"
      }
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "args": {
        "pane": 0,
        "tf": "5m"
      }
    },
    {
      "action": "wait_frames",
      "count": 6
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "args": {
        "pane": 0,
        "tf": "1h"
      }
    },
    {
      "action": "wait_frames",
      "count": 6
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "pane_timeframe_equals": {
            "pane": 0,
            "tf": "1h"
          }
        },
        {
          "fps_above": 5
        }
      ]
    },
    {
      "action": "reset"
    }
  ]
}
