{
  "name": "pane1_dom_rty",
  "description": "RTY: dom subsystem drives correctly on pane 1 (independence).",
  "story": "MultiPane/Dom",
  "tags": [
    "multipane",
    "dom",
    "independence"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SetLayout",
      "layout": "2"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 1,
      "symbol": "RTY"
    },
    {
      "action": "wait",
      "ms": 900
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SetDomSidebar",
      "pane": 1,
      "open": true
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "log",
      "message": "pane1 dom RTY"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_gte": {
            "path": "panes.1.dom_level_count",
            "min": 1
          }
        },
        {
          "dom_spread_sane": {
            "pane": 1
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}
