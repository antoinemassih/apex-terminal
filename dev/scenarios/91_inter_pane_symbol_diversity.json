{
  "name": "91_inter_pane_symbol_diversity",
  "description": "Quad layout with 4 fully distinct symbols (SPY/AAPL/TSLA/NVDA), verifying all panes render without conflicts or FPS drops.",
  "tags": ["inter-pane", "symbol"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "Quad" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "pane_count_equals": 4 } ] },
    { "action": "cmd_batch", "cmds": [
      { "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "SPY" } },
      { "cmd": "SwapPaneSymbol", "args": { "pane": 1, "symbol": "AAPL" } },
      { "cmd": "SwapPaneSymbol", "args": { "pane": 2, "symbol": "TSLA" } },
      { "cmd": "SwapPaneSymbol", "args": { "pane": 3, "symbol": "NVDA" } }
    ]},
    { "action": "wait_frames", "count": 10 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "no_active_violations": true },
      { "no_clipped_widgets": true }
    ] },
    { "action": "snapshot", "name": "quad_symbol_diversity" }
  ]
}
