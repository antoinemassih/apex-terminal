{
  "name": "canvas_viewport_assertions",
  "description": "Set viewport price range and verify price_contains and px_per_bar",
  "story": "Canvas Introspection",
  "priority": 1,
  "tags": ["canvas", "viewport"],
  "steps": [
    {"action": "reset"},
    {"action": "wait", "ms": 30},
    {"action": "cmd", "cmd": "SetViewport", "pane": 0,
     "price_low": 400.0, "price_high": 500.0},
    {"action": "wait", "ms": 30},
    {"action": "assert", "assertions": [
      {"canvas_viewport_price_contains": {"pane": 0, "price": 450.0}},
      {"canvas_viewport_price_contains": {"pane": 0, "price": 400.0}},
      {"canvas_viewport_price_contains": {"pane": 0, "price": 500.0}},
      {"canvas_viewport_px_per_bar_gte": {"pane": 0, "min": 1.0}}
    ]}
  ]
}
