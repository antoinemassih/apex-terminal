{
  "name": "dialog_lifecycle",
  "description": "Open the indicator editor via AddIndicator, verify it is tracked as an open dialog, then close all dialogs and verify it is gone.",
  "tags": ["dialog", "indicator", "design"],
  "settle_ms": 50,
  "abort_on_failure": true,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 2 },
    {
      "action": "assert",
      "assertions": [
        { "no_open_dialogs": true },
        { "fps_above": 5.0 }
      ]
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "args": { "pane": 0, "kind": "RSI" }
    },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "fps_above": 5.0 },
        { "no_active_violations": true }
      ]
    },
    {
      "action": "cmd",
      "cmd": "CloseAllDialogs"
    },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "no_open_dialogs": true },
        { "fps_above": 5.0 },
        { "no_active_violations": true }
      ]
    },
    { "action": "log", "message": "Dialog lifecycle passed — indicator editor opened and closed cleanly." }
  ]
}
