{
  "name": "matrix_heatmap_btc_usd",
  "description": "BTC-USD: heatmap subsystem drives + observes correctly.",
  "story": "Matrix/Heatmap",
  "tags": [
    "matrix",
    "heatmap",
    "breadth"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "BTC-USD"
    },
    {
      "action": "wait",
      "ms": 900
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SeedHeatmapCells",
      "count": 40
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "log",
      "message": "heatmap BTC-USD"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "heatmap.cell_count",
            "value": 40
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}