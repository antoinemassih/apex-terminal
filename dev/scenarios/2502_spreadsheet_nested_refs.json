{
  "name": "spreadsheet_nested_refs",
  "description": "Formulas that reference other formula cells resolve correctly (nested).",
  "story": "Spreadsheet/Formula",
  "tags": [
    "spreadsheet",
    "formula",
    "correctness"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "ChangePaneType",
      "pane": 0,
      "kind": "Spreadsheet"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SetCell",
      "pane": 0,
      "row": 0,
      "col": 0,
      "text": "4"
    },
    {
      "action": "cmd",
      "cmd": "SetCell",
      "pane": 0,
      "row": 1,
      "col": 0,
      "text": "6"
    },
    {
      "action": "cmd",
      "cmd": "SetCell",
      "pane": 0,
      "row": 2,
      "col": 0,
      "text": "8"
    },
    {
      "action": "cmd",
      "cmd": "SetCell",
      "pane": 0,
      "row": 0,
      "col": 1,
      "text": "=SUM(A1:A3)"
    },
    {
      "action": "cmd",
      "cmd": "SetCell",
      "pane": 0,
      "row": 1,
      "col": 1,
      "text": "=MAX(A1:A3)-MIN(A1:A3)"
    },
    {
      "action": "cmd",
      "cmd": "SetCell",
      "pane": 0,
      "row": 2,
      "col": 1,
      "text": "=B1+B2"
    },
    {
      "action": "cmd",
      "cmd": "SetCell",
      "pane": 0,
      "row": 3,
      "col": 1,
      "text": "=B3*2"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "nested_refs"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "spreadsheet_cell_equals": {
            "pane": 0,
            "row": 0,
            "col": 1,
            "value": 18
          }
        },
        {
          "spreadsheet_cell_equals": {
            "pane": 0,
            "row": 1,
            "col": 1,
            "value": 4
          }
        },
        {
          "spreadsheet_cell_equals": {
            "pane": 0,
            "row": 2,
            "col": 1,
            "value": 22
          }
        },
        {
          "spreadsheet_cell_equals": {
            "pane": 0,
            "row": 3,
            "col": 1,
            "value": 44
          }
        },
        {
          "pane_type_equals": {
            "pane": 0,
            "type": "Spreadsheet"
          }
        },
        {
          "no_panic": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}