{
  "name": "capture_pane_state",
  "description": "Exercises the capture step: saves initial symbol to captures map, swaps symbol, then asserts the capture still holds original value via captures_equal.",
  "story": "Chart/StateCapture",
  "priority": 1,
  "tags": ["capture", "extension", "chart"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "capture", "path": "active_symbol", "as": "initial_symbol" },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "QQQ" } },
    { "action": "wait_frames", "count": 2 },
    {
      "action": "assert",
      "assertions": [
        { "captures_equal": { "key": "initial_symbol", "equals": "SPY" } },
        { "active_symbol_equals": "QQQ" }
      ]
    },
    { "action": "reset" }
  ]
}
