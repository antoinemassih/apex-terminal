{
  "name": "canvas_bars_valid",
  "description": "Verify all visible bars have valid OHLC and bar count is non-zero",
  "story": "Canvas Introspection",
  "priority": 1,
  "tags": ["canvas", "bars", "smoke"],
  "steps": [
    {"action": "reset"},
    {"action": "wait", "ms": 30},
    {"action": "assert", "assertions": [
      {"canvas_bar_ohlc_valid":        {"pane": 0}},
      {"canvas_visible_bar_count_gte": {"pane": 0, "min": 1}}
    ]}
  ]
}
