{
  "name": "crossasset_study_btc_usd",
  "description": "Trader studies BTC-USD on 1h with SMA+BB; indicators compute on cross-asset data.",
  "story": "CrossAsset/Study",
  "tags": [
    "crossasset",
    "indicator",
    "invariants"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "BTC-USD"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 0,
      "tf": "1h"
    },
    {
      "action": "wait",
      "ms": 900
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "pane": 0,
      "kind": "SMA"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "pane": 0,
      "kind": "BB"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "RecomputeIndicators",
      "pane": 0
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "log",
      "message": "BTC-USD 1h study"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "BTC-USD"
          }
        },
        {
          "canvas_indicator_exists": {
            "pane": 0,
            "kind": "SMA"
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        },
        {
          "canvas_bars_within_pane": {
            "pane": 0
          }
        }
      ]
    }
  ]
}