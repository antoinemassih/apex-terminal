{
  "name": "pane_indicator_isolation_cross",
  "description": "Two panes. Add RSI to pane 0, MACD to pane 1. Assert each pane has exactly 1 indicator. Verifies cross-pane isolation.",
  "story": "MultiPane/Indicators",
  "tags": ["multi-pane", "indicators", "isolation", "cross-pane"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "TwoColumns" } },
    { "action": "wait_frames", "count": 3 },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "RSI" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 1, "kind": "MACD" } },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "indicator_count_equals": { "pane": 0, "count": 1 } },
        { "indicator_count_equals": { "pane": 1, "count": 1 } },
        { "fps_above": 5.0 }
      ]
    },
    { "action": "reset" }
  ]
}
