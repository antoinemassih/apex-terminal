{
  "name": "gamma_synth_nq",
  "description": "SynthGamma on NQ populates GEX levels and call/put walls.",
  "story": "Options/Gamma",
  "tags": [
    "options",
    "gamma",
    "correctness"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "NQ"
    },
    {
      "action": "wait",
      "ms": 1100
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SynthGamma",
      "pane": 0
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "log",
      "message": "gamma synth NQ"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "gamma_overlay_active": {
            "pane": 0
          }
        },
        {
          "state_field_gte": {
            "path": "panes.0.gamma_level_count",
            "min": 1
          }
        },
        {
          "gamma_structure_sane": {
            "pane": 0
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        },
        {
          "canvas_bars_within_pane": {
            "pane": 0
          }
        }
      ]
    }
  ]
}