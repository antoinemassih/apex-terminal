{
  "name": "story_options_section_underlying",
  "description": "Trader adds option sections tied to underlyings on the watchlist.",
  "story": "Watchlist/Options",
  "tags": [
    "story",
    "watchlist",
    "options"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "Build an options section for an underlying"
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "AAPL"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddOptionSection",
      "title": "AAPL Options"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "SPY"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddOptionSection",
      "title": "SPY Options"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}