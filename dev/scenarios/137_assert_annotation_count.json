{
  "name": "assert_annotation_count",
  "description": "Tests annotation_count_equals by upserting two annotations (with required rect) then clearing them.",
  "story": "TestInfra/AssertEngine",
  "tags": ["assert-engine", "annotations"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "annotate", "clear": true },
    { "action": "wait_frames", "count": 1 },
    { "action": "assert", "assertions": [
      { "annotation_count_equals": 0 }
    ]},
    { "action": "log", "message": "Upserting 2 annotations with rect fields" },
    { "action": "annotate", "annotations": [
      { "id": "ann_a", "rect": { "x": 10, "y": 10, "w": 200, "h": 50 }, "label": "Entry",  "color": [0, 200, 100, 180] },
      { "id": "ann_b", "rect": { "x": 10, "y": 70, "w": 200, "h": 50 }, "label": "Exit",   "color": [200, 50, 50, 180] }
    ]},
    { "action": "wait_frames", "count": 1 },
    { "action": "assert", "assertions": [
      { "annotation_count_equals": 2 }
    ]},
    { "action": "log", "message": "Clearing all annotations" },
    { "action": "annotate", "clear": true },
    { "action": "wait_frames", "count": 1 },
    { "action": "assert", "assertions": [
      { "annotation_count_equals": 0 }
    ]},
    { "action": "log", "message": "annotation_count_equals assertions passed" }
  ]
}
