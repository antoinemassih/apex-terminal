{
  "name": "sector_rotation_vs_index",
  "description": "Pane 1 anchors the SPY index while pane 0 rotates through semiconductor names NVDA, AMD, AVGO, MSFT.",
  "story": "MultiAsset/SectorRotation",
  "tags": [
    "story",
    "multipane",
