{
  "name": "stress_all_indicators_at_once",
  "description": "Add ALL 19 indicators to one pane at once, recompute, then hide; survive it.",
  "story": "Adversarial/Stress",
  "tags": [
    "stress",
    "indicator",
    "perf"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
