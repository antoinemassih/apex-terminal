{
  "name": "options_fps_stability",
  "description": "Switch pane 0 to OptionsFlow, verify pane type, then wait 10 frames asserting fps stays above 5.",
  "story": "OptionsChain/Performance",
  "tags": ["options", "fps", "perf"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "log", "message": "Switching to OptionsFlow" },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 0, "kind": "OptionsFlow" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "pane_type_equals": { "pane": 0, "type": "OptionsFlow" } }
    ] },
    { "action": "log", "message": "Waiting 10 more frames to confirm fps stability" },
    { "action": "wait_frames", "count": 10 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "no_active_violations": true }
    ] },
    { "action": "reset" }
  ]
}
