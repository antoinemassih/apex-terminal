{
  "name": "canvas_indicator_overwrite",
  "description": "Setting same indicator kind twice keeps the last value and count stays 1",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": [
    "canvas",
    "indicators"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "cmd",
      "cmd": "SetIndicatorOutput",
      "pane": 0,
      "kind": "SMA",
      "value": 100
    },
    {
      "action": "wait",
      "ms": 20
    },
    {
      "action": "cmd",
      "cmd": "SetIndicatorOutput",
      "pane": 0,
      "kind": "SMA",
      "value": 200
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_indicator_last_value_near": {
            "pane": 0,
            "kind": "SMA",
            "value": 200,
            "tolerance": 0.01
          }
        },
        {
          "canvas_indicator_count_equals": {
            "pane": 0,
            "count": 1
          }
        }
      ]
    }
  ]
}
