{
  "name": "canvas_indicator_rsi_bounds",
  "description": "RSI indicator value in expected bullish range",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": [
    "canvas",
    "indicators"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "cmd",
      "cmd": "SetIndicatorOutput",
      "pane": 0,
      "kind": "RSI",
      "value": 65
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_indicator_value_in_range": {
            "pane": 0,
            "kind": "RSI",
            "min": 60,
            "max": 70
          }
        },
        {
          "canvas_indicator_last_value_near": {
            "pane": 0,
            "kind": "RSI",
            "value": 65,
            "tolerance": 0.01
          }
        }
      ]
    }
  ]
}