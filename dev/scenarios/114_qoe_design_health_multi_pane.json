{
  "name": "114_qoe_design_health_multi_pane",
  "description": "TwoColumns with indicators on both panes, assert no_unintended_overlap in the layout to confirm pane boundaries are respected.",
  "tags": ["qoe", "design", "pane"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "TwoColumns" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "SPY" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "RSI" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "MACD" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 1, "symbol": "QQQ" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 1, "kind": "VWAP" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 1, "kind": "BB" } },
    { "action": "wait_frames", "count": 10 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "no_clipped_widgets": true },
      { "no_active_violations": true }
    ] },
    { "action": "assert_layout", "assertions": [
      { "no_unintended_overlap": { "layer": 0 } },
      { "toolbar_buttons_aligned": true }
    ] }
  ]
}
