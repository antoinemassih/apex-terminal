{
  "name": "strikes_overlay_aapl",
  "description": "Enabling the strikes overlay on AAPL actually loads option-chain rows.",
  "story": "Options/Strikes",
  "tags": [
    "options",
    "strikes",
    "correctness"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "AAPL"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SetChartFlag",
      "pane": 0,
      "flag": "ShowStrikesOverlay",
      "value": true
    },
    {
      "action": "wait",
      "ms": 7000
    },
    {
      "action": "wait_frames",
      "count": 8
    },
    {
      "action": "log",
      "message": "strikes on AAPL"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "strikes_overlay_active": {
            "pane": 0
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}