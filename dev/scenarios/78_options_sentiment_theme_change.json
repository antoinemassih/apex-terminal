{
  "name": "options_sentiment_theme_change",
  "description": "Switch to OptionsSentiment pane, cycle theme (idx 0 -> 4 -> 8), check FPS each step.",
  "story": "UserJourney/OptionsPanel",
  "tags": ["options", "theme"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 0, "kind": "OptionsSentiment" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "pane_type_equals": { "pane": 0, "type": "OptionsSentiment" } }] },
    { "action": "log", "message": "Setting theme idx 0" },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "idx": 0 } },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "log", "message": "Setting theme idx 4" },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "idx": 4 } },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "log", "message": "Setting theme idx 8" },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "idx": 8 } },
    { "action": "wait_frames", "count": 4 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] }
  ]
}
