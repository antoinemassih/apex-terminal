{
  "name": "canvas_indicator_bollingerbands",
  "description": "Bollinger Bands reports midline (value) and upper band (value2)",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": ["canvas", "indicators"],
  "steps": [
    {"action": "reset"},
    {"action": "wait", "ms": 30},
    {"action": "cmd", "cmd": "SetIndicatorOutput", "pane": 0, "kind": "BollingerBands", "value": 450, "value2": 462.5},
    {"action": "wait", "ms": 30},
    {"action": "assert", "assertions": [
      {"canvas_indicator_exists": {"pane": 0, "kind": "BollingerBands"}},
      {"canvas_indicator_value2_near": {"pane": 0, "kind": "BollingerBands", "value": 462.5, "tolerance": 0.1}}
    ]}
  ]
}
