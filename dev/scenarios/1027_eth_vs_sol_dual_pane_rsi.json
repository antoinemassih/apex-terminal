{
  "name": "crypto_eth_vs_sol_dual_pane_rsi",
  "description": "ETH-USD (pane 0) vs SOL-USD (pane 1) relative-strength on 15m with RSI.",
  "story": "Crypto/CrossAsset",
  "tags": [
    "story",
    "crypto",
    "eth",
    "sol",
    "dual-pane",
    "rsi",
    "invariants"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "ETH pane 0 vs SOL pane 1 relative strength"
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "ETH-USD"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 0,
      "tf": "15m"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 1,
      "symbol": "SOL-USD"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 1,
      "tf": "15m"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "pane": 0,
      "kind": "RSI"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "pane": 1,
      "kind": "RSI"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "ETH-USD"
          }
        },
        {
          "pane_symbol_equals": {
            "pane": 1,
            "symbol": "SOL-USD"
          }
        },
        {
          "canvas_indicator_value_in_range": {
            "pane": 0,
            "kind": "RSI",
            "min": 0,
            "max": 100
          }
        },
        {
          "canvas_indicator_value_in_range": {
            "pane": 1,
            "kind": "RSI",
            "min": 0,
            "max": 100
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 1
          }
        }
      ]
    }
  ]
}