{
  "name": "chart_extended_hours",
  "description": "Toggle ExtendedHours flag on and off, verify no violations and stable FPS each time.",
  "story": "Chart/Settings",
  "tags": ["chart", "flags"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "log", "message": "Enabling ExtendedHours" },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "ExtendedHours", "value": true } },
    { "action": "wait_frames", "count": 4 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "log", "message": "Disabling ExtendedHours" },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "ExtendedHours", "value": false } },
    { "action": "wait_frames", "count": 4 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] }
  ]
}
