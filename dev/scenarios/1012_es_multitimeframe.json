{
  "name": "story_es_multitimeframe",
  "description": "Top-down ES multi-timeframe analysis 1m through daily.",
  "story": "Futures/MultiTimeframe",
  "tags": [
    "story",
    "futures",
    "es",
    "multitimeframe",
    "topdown"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "ES multi-timeframe analysis 1m -> 15m -> 1h -> 1d"
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "ES"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "ES"
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 0,
      "tf": "1m"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_timeframe_equals": {
            "pane": 0,
            "tf": "1m"
          }
        },
        {
          "canvas_visible_bar_count_gte": {
            "pane": 0,
            "min": 1
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        }
      ]
    },
    {
