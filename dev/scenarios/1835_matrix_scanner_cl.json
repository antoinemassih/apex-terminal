{
  "name": "matrix_scanner_cl",
  "description": "CL: scanner subsystem drives + observes correctly.",
  "story": "Matrix/Scanner",
  "tags": [
    "matrix",
    "scanner",
    "breadth"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "CL"
    },
    {
      "action": "wait",
      "ms": 900
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SetScannerOpen",
      "open": true
    },
    {
      "action": "cmd",
      "cmd": "SeedScannerResults",
      "count": 40
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "log",
      "message": "scanner CL"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "scanner.result_count",
            "value": 40
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}