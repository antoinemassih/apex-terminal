{
  "name": "canvas_indicator_macd",
  "description": "MACD indicator reports histogram (value) and signal line (value2)",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": ["canvas", "indicators"],
  "steps": [
    {"action": "reset"},
    {"action": "wait", "ms": 30},
    {"action": "cmd", "cmd": "SetIndicatorOutput", "pane": 0, "kind": "MACD", "value": 1.5, "value2": 0.8},
    {"action": "wait", "ms": 30},
    {"action": "assert", "assertions": [
      {"canvas_indicator_exists": {"pane": 0, "kind": "MACD"}},
      {"canvas_indicator_value2_near": {"pane": 0, "kind": "MACD", "value": 0.8, "tolerance": 0.1}}
    ]}
  ]
}
