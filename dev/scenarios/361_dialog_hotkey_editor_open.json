{
  "name": "dialog_hotkey_editor_open",
  "description": "OpenHotkeyEditor — dialog_open \"hotkey_editor\".",
  "story": "Dialog/Lifecycle",
  "tags": [
    "dialog"
  ],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "cmd",
      "cmd": "OpenHotkeyEditor",
      "args": {}
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "assert",
      "assertions": [
        {
          "dialog_open": "hotkey_editor"
        },
        {
          "fps_above": 5
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "CloseHotkeyEditor",
      "args": {}
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "reset"
    }
  ]
}