{
  "name": "canvas_four_pane_layout",
  "description": "HeadlessLayout cols=4 creates 4 canvas panes",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": [
    "canvas",
    "pane"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "cmd",
      "cmd": "HeadlessLayout",
      "cols": 4
    },
    {
      "action": "wait",
      "ms": 50
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_pane_count_equals": 4
        }
      ]
    }
  ]
}