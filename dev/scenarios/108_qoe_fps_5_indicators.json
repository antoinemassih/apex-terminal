{
  "name": "108_qoe_fps_5_indicators",
  "description": "Load 5 indicators (RSI+MACD+VWAP+BB+ATR) on a single chart pane and assert fps_above 5.0, testing the mid-tier indicator render cost.",
  "story": "QoE/Full",
  "tags": ["qoe", "fps", "indicators"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "SPY" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "RSI" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "MACD" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "VWAP" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "BB" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "ATR" } },
    { "action": "wait_frames", "count": 10 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "indicator_count_equals": 5 },
      { "no_active_violations": true }
    ] }
  ]
}
