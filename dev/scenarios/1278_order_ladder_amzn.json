{
  "name": "order_ladder_amzn",
  "description": "Ladder four DRAFT orders on AMZN, toggle the panel, cancel-clean; never submits.",
  "story": "Trading/Orders",
  "tags": [
    "orders",
    "safe",
    "panel"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "AMZN"
    },
    {
      "action": "wait",
      "ms": 900
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SeedDraftOrder",
      "pane": 0,
      "side": "buy",
      "price": 95.0,
      "qty": 100
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "SeedDraftOrder",
      "pane": 0,
      "side": "sell",
      "price": 100.0,
      "qty": 100
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "SeedDraftOrder",
      "pane": 0,
      "side": "buy",
      "price": 105.0,
      "qty": 100
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "SeedDraftOrder",
      "pane": 0,
      "side": "sell",
      "price": 110.0,
      "qty": 100
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_gte": {
            "path": "panes.0.order_draft_count",
            "min": 2
          }
        },
        {
          "no_live_orders": true
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "SetOrderPanel",
      "pane": 0,
      "collapsed": true
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "panes.0.order_panel_collapsed",
            "value": true
          }
        },
        {
          "no_live_orders": true
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "SetOrderPanel",
      "pane": 0,
      "collapsed": false
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "CancelAllOrders"
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "panes.0.order_count",
            "value": 0
          }
        },
        {
          "no_live_orders": true
        },
        {
          "no_panic": true
        }
      ]
    }
  ]
}