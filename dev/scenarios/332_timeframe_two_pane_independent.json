{
  "name": "timeframe_two_pane_independent",
  "description": "TwoColumns layout: pane 0 on 1m, pane 1 on 1d. Assert each pane has its own timeframe.",
  "story": "Timeframe/Switching",
  "tags": [
    "timeframe",
    "pane"
  ],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "cmd",
      "cmd": "SetLayout",
      "args": {
        "layout": "TwoColumns"
      }
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "args": {
        "pane": 0,
        "symbol": "SPY"
      }
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "args": {
        "pane": 1,
        "symbol": "QQQ"
      }
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "args": {
        "pane": 0,
        "tf": "1m"
      }
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "args": {
        "pane": 1,
        "tf": "1d"
      }
    },
    {
      "action": "wait_frames",
      "count": 6
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_timeframe_equals": {
            "pane": 0,
            "tf": "1m"
          }
        },
        {
          "pane_timeframe_equals": {
            "pane": 1,
            "tf": "1d"
          }
        },
        {
          "fps_above": 5
        }
      ]
    },
    {
      "action": "reset"
    }
  ]
}
