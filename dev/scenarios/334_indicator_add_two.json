{
  "name": "indicator_add_two",
  "description": "Add RSI then MACD to same pane: indicator_count_equals 2.",
  "story": "Indicator/Lifecycle",
  "tags": [
    "indicator",
    "lifecycle"
  ],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "args": {
        "pane": 0,
        "kind": "RSI"
      }
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "args": {
        "pane": 0,
        "kind": "MACD"
      }
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "indicator_count_equals": {
            "pane": 0,
            "count": 2
          }
        },
        {
          "fps_above": 5
        }
      ]
    },
    {
      "action": "reset"
    }
  ]
}