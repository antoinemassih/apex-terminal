{
  "name": "pane1_gamma_msft",
  "description": "MSFT: gamma subsystem drives correctly on pane 1 (independence).",
  "story": "MultiPane/Gamma",
  "tags": [
    "multipane",
    "gamma",
    "independence"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SetLayout",
      "layout": "2"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 1,
      "symbol": "MSFT"
    },
    {
      "action": "wait",
      "ms": 900
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SynthGamma",
      "pane": 1
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "log",
      "message": "pane1 gamma MSFT"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "gamma_overlay_active": {
            "pane": 1
          }
        },
        {
          "state_field_gte": {
            "path": "panes.1.gamma_level_count",
            "min": 1
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}
