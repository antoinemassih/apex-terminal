{
  "name": "layout_cycle_ascending",
  "description": "Cycle layouts from 1 to 4 panes, asserting correct pane count at each step.",
  "story": "Layout/System",
  "tags": [
    "layout",
    "pane"
  ],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "cmd",
      "cmd": "SetLayout",
      "args": {
        "layout": "One"
      }
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_count_equals": 1
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "SetLayout",
      "args": {
        "layout": "TwoColumns"
      }
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_count_equals": 2
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "SetLayout",
      "args": {
        "layout": "ThreeColumns"
      }
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_count_equals": 3
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "SetLayout",
      "args": {
        "layout": "FourGrid"
      }
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_count_equals": 4
        },
        {
          "fps_above": 5
        }
      ]
    },
    {
      "action": "reset"
    }
  ]
}
