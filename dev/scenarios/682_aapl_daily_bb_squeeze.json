{
  "name": "aapl_daily_bb_squeeze",
  "description": "Swing trader hunts a Bollinger Band squeeze on the AAPL daily chart.",
  "story": "SwingTrading/Volatility",
  "tags": [
    "story",
    "swing",
    "bollinger",
    "squeeze"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "AAPL daily Bollinger Band squeeze scan"
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "AAPL"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        },
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "AAPL"
          }
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 0,
      "tf": "1d"
