{
  "name": "options_flow_pane",
  "description": "Options trader switches a QQQ pane into the OptionsFlow view.",
  "story": "Options/Flow",
  "tags": [
    "story",
    "options",
    "flow",
    "panetype"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "Switch QQQ pane to OptionsFlow"
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "QQQ"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "ChangePaneType",
      "pane": 0,
      "kind": "OptionsFlow"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}