{
  "name": "94_inter_pane_indicator_isolation",
  "description": "Quad layout: add RSI only to pane0, verify it does not bleed to other panes, then add MACD exclusively to pane1. Confirms per-pane indicator isolation.",
  "story": "Layout/Panes",
  "tags": ["inter-pane", "indicators"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "Quad" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "pane_count_equals": 4 } ] },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "SPY" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 1, "symbol": "QQQ" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "RSI" } },
    { "action": "wait_frames", "count": 6 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "indicator_count_equals": 1 }
    ] },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 1, "kind": "MACD" } },
    { "action": "wait_frames", "count": 6 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "no_active_violations": true }
    ] }
  ]
}
