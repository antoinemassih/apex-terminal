{
  "name": "story_etf_watchlist",
  "description": "Trader builds a broad market and sector ETF watchlist.",
  "story": "Watchlist/ThemedBuild",
  "tags": [
    "story",
    "watchlist",
    "etf"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "Build a broad-ETF watchlist"
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "SPY"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "QQQ"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "IWM"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "DIA"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "GLD"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "XLF"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "XLK"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}