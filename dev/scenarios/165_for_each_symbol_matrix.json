{
  "name": "for_each_symbol_matrix",
  "description": "Exercises the for_each step action: iterates over 4 symbols, swaps each into pane 0, asserts state is non-null after each.",
  "story": "Chart/SymbolMatrix",
  "priority": 1,
  "tags": ["for_each", "extension", "chart"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "for_each",
      "var": "symbol",
      "items": ["SPY", "QQQ", "AAPL", "NVDA"],
      "steps": [
        { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "{{symbol}}" } },
        { "action": "wait_frames", "count": 2 },
        {
          "action": "assert",
          "assertions": [
            { "state_field_not_null": "active_symbol" },
            { "fps_above": 5.0 }
          ]
        }
      ]
    },
    { "action": "reset" }
  ]
}
