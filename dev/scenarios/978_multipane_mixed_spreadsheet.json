{
  "name": "multipane_mixed_spreadsheet",
  "description": "Trading desk: pane 0 charts AAPL while pane 1 shows the Spreadsheet view.",
  "story": "Chart/MultiPane",
  "tags": [
    "multipane",
    "panetype",
    "invariants"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "AAPL"
    },
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "ChangePaneType",
      "pane": 1,
      "kind": "Spreadsheet"
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "log",
      "message": "pane0 AAPL chart / pane1 Spreadsheet"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "AAPL"
          }
        },
        {
          "pane_type_equals": {
            "pane": 1,
            "type": "Spreadsheet"
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}