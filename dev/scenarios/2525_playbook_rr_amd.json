{
  "name": "playbook_rr_amd",
  "description": "Playbook AMD long computes risk/reward 3.0 correctly.",
  "story": "Playbook/RiskReward",
  "tags": [
    "playbook",
    "riskreward",
    "correctness"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "SetPlaybookPanel",
      "open": true
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SeedPlay",
      "symbol": "AMD",
      "long": true,
      "entry": 120.0,
      "target": 138.0,
      "stop": 114.0
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "play AMD rr=3.0"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "playbook.open",
            "value": true
          }
        },
        {
          "state_field_equals": {
            "path": "playbook.play_count",
            "value": 1
          }
        },
        {
          "state_field_equals": {
            "path": "playbook.plays.0.risk_reward",
            "value": 3.0
          }
        },
        {
          "play_rr_correct": true
        },
        {
          "no_panic": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}