{
  "name": "84_pane_layout_cycle_all",
  "description": "Cycle through all layouts Single→TwoColumns→TwoRows→Quad→Single, asserting FPS at each step to ensure transitions are stable.",
  "tags": ["pane", "layout", "fps"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 }, { "pane_count_equals": 1 } ] },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "TwoColumns" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 }, { "pane_count_equals": 2 } ] },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "TwoRows" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 }, { "pane_count_equals": 2 } ] },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "Quad" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 }, { "pane_count_equals": 4 } ] },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "Single" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 }, { "pane_count_equals": 1 }, { "no_active_violations": true } ] }
  ]
}
