{
  "name": "convergence_tf_storm_settle",
  "description": "Storm through wildly varying timeframes with no settle then request 15m with a generous wait, asserting timeframe convergence.",
  "story": "Recovery/Convergence",
  "tags": [
    "story",
    "stress",
    "convergence",
    "timeframe"
  ],
  "priority": 2,
  "settle_ms": 10,
  "abort_on_failure": false,
  "steps": [
