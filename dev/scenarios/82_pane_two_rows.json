{
  "name": "82_pane_two_rows",
  "description": "Set TwoRows layout, assert pane count equals 2, assign AAPL 1h to pane 0 and MSFT 5m to pane 1, assert FPS.",
  "story": "Layout/Panes",
  "tags": ["pane", "layout"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "TwoRows" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "pane_count_equals": 2 } ] },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "AAPL" } },
    { "action": "cmd", "cmd": "ChangeTimeframe", "args": { "pane": 0, "tf": "1h" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 1, "symbol": "MSFT" } },
    { "action": "cmd", "cmd": "ChangeTimeframe", "args": { "pane": 1, "tf": "5m" } },
    { "action": "wait_frames", "count": 8 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "pane_count_equals": 2 },
      { "no_active_violations": true }
    ] }
  ]
}
