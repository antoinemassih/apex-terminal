{
  "name": "indicator_survives_tf_change",
  "description": "Add RSI to pane 0. Cycle through 4 timeframes via for_each. Assert indicator count remains 1 after each timeframe change.",
  "story": "PaneState/Preservation",
  "tags": ["pane-state", "preservation", "indicators", "timeframe"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "RSI" } },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "for_each",
      "var": "tf",
      "items": ["5m", "15m", "1h", "1d"],
      "steps": [
        { "action": "cmd", "cmd": "ChangeTimeframe", "args": { "pane": 0, "tf": "{{tf}}" } },
        { "action": "wait_frames", "count": 2 },
        {
          "action": "assert",
          "assertions": [
            { "indicator_count_equals": { "pane": 0, "count": 1 } }
          ]
        }
      ]
    },
    {
      "action": "assert",
      "assertions": [
        { "fps_above": 5.0 }
      ]
    },
    { "action": "reset" }
  ]
}
