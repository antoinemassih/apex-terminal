{
  "name": "canvas_drawing_survives_viewport",
  "description": "Drawing persists unaffected after viewport change",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": [
    "canvas",
    "drawings"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "level",
      "kind": "HorizLine",
      "price_a": 450
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "cmd",
      "cmd": "SetViewport",
      "pane": 0,
      "price_low": 420,
      "price_high": 480
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_drawing_exists": {
            "pane": 0,
            "id": "level"
          }
        },
        {
          "canvas_drawing_count_equals": {
            "pane": 0,
            "count": 1
          }
        },
        {
          "canvas_viewport_price_contains": {
            "pane": 0,
            "price": 450
          }
        }
      ]
    }
  ]
}