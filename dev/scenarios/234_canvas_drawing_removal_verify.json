{
  "name": "canvas_drawing_removal_verify",
  "description": "After removing one drawing, count decreases and id is gone",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": [
    "canvas",
    "drawings"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "keep1",
      "kind": "HorizLine",
      "price_a": 430
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "remove_me",
      "kind": "HorizLine",
      "price_a": 440
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "keep2",
      "kind": "HorizLine",
      "price_a": 450
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "cmd",
      "cmd": "RemoveDrawing",
      "pane": 0,
      "id": "remove_me"
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_drawing_count_equals": {
            "pane": 0,
            "count": 2
          }
        },
        {
          "canvas_drawing_exists": {
            "pane": 0,
            "id": "keep1"
          }
        },
        {
          "canvas_drawing_exists": {
            "pane": 0,
            "id": "keep2"
          }
        },
        {
          "canvas_drawing_not_exists": {
            "pane": 0,
            "id": "remove_me"
          }
        }
      ]
    }
  ]
}
