{
  "name": "87_pane_type_mix_two",
  "description": "TwoColumns layout with mixed pane types: pane0=Chart, pane1=Dashboard. Verify pane_type_equals on each and assert FPS.",
  "story": "Layout/Panes",
  "tags": ["pane", "types"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "TwoColumns" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "pane_count_equals": 2 } ] },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 0, "kind": "Chart" } },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 1, "kind": "Dashboard" } },
    { "action": "wait_frames", "count": 8 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "pane_type_equals": { "pane": 0, "type": "Chart" } },
      { "pane_type_equals": { "pane": 1, "type": "Dashboard" } },
      { "no_active_violations": true }
    ] }
  ]
}
