{
  "name": "93_inter_pane_design_health",
  "description": "TwoColumns with indicators on both panes, then run full design health audit: no_clipped_widgets, no_active_violations, all_touch_targets_ok.",
  "tags": ["inter-pane", "design"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "TwoColumns" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "AAPL" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "RSI" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "VWAP" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 1, "symbol": "MSFT" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 1, "kind": "MACD" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 1, "kind": "BB" } },
    { "action": "wait_frames", "count": 10 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "no_clipped_widgets": true },
      { "no_active_violations": true },
      { "all_touch_targets_ok": 24 }
    ] }
  ]
}
