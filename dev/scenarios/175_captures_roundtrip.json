{
  "name": "captures_roundtrip",
  "description": "Full roundtrip: capture multiple state fields, mutate state, verify captures still hold original values via captures_equal.",
  "story": "Captures/Roundtrip",
  "priority": 1,
  "tags": ["extension", "captures"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "capture", "path": "active_symbol",    "as": "sym_before" },
    { "action": "capture", "path": "pane_count",       "as": "panes_before" },
    { "action": "capture", "path": "active_timeframe", "as": "tf_before" },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "NVDA" } },
    { "action": "cmd", "cmd": "ChangeTimeframe", "args": { "pane": 0, "tf": "1h" } },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "captures_equal": { "key": "sym_before",   "equals": "SPY" } },
        { "captures_equal": { "key": "panes_before", "equals": 1 } },
        { "captures_equal": { "key": "tf_before",    "equals": "5m" } },
        { "active_symbol_equals": "NVDA" },
        { "active_timeframe_equals": "1h" }
      ]
    },
    { "action": "reset" }
  ]
}
