{
  "name": "watchlist_toggle_collapse",
  "description": "WatchlistToggleSectionCollapse: add section, toggle collapse on/off, verify collapsed field flips. Tests a handler that exists but has zero scenario coverage.",
  "tags": ["watchlist", "coverage"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 2 },
    { "action": "cmd", "cmd": "WatchlistAddSection", "args": { "title": "Tech" } },
    { "action": "wait_frames", "count": 2 },
    { "action": "log", "message": "Section should start expanded (collapsed=false)" },
    { "action": "assert", "assertions": [
      { "state_field_lte": { "path": "watchlist.section_count", "max": 1 } }
    ]},
    { "action": "log", "message": "Toggling collapse on idx 0" },
    { "action": "cmd", "cmd": "WatchlistToggleSectionCollapse", "args": { "idx": 0 } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [
      { "state_field_gte": { "path": "watchlist.section_count", "min": 1 } },
      { "fps_above": 5.0 }
    ]},
    { "action": "log", "message": "Toggling collapse back (expand)" },
    { "action": "cmd", "cmd": "WatchlistToggleSectionCollapse", "args": { "idx": 0 } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "no_active_violations": true }
    ]},
    { "action": "log", "message": "Collapse toggle round-trip verified" }
  ]
}
