{
  "name": "order_entry_multi_pane",
  "description": "Set a two-pane layout, open the order entry dialog, verify it is open with 2 panes active, then close it.",
  "story": "OrderEntry/Layout",
  "tags": ["order_entry", "layout", "multi_pane"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "log", "message": "Setting TwoColumns layout" },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "TwoColumns" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [{ "pane_count_equals": 2 }] },
    { "action": "log", "message": "Opening order entry dialog in 2-pane state" },
    { "action": "cmd", "cmd": "OpenOrderEntry", "args": {} },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [
      { "dialog_open": "order_entry" },
      { "pane_count_equals": 2 },
      { "fps_above": 5.0 }
    ] },
    { "action": "log", "message": "Closing order entry" },
    { "action": "cmd", "cmd": "CloseOrderEntry", "args": {} },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [
      { "no_open_dialogs": true },
      { "pane_count_equals": 2 }
    ] },
    { "action": "reset" }
  ]
}
