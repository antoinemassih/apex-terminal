{
  "name": "options_flow_pane_switch",
  "description": "Switch pane 0 to OptionsFlow, verify pane type is OptionsFlow, then switch back to Chart.",
  "story": "OptionsChain/PaneSwitching",
  "tags": ["options", "pane"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "log", "message": "Switching pane 0 to OptionsFlow" },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 0, "kind": "OptionsFlow" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "pane_type_equals": { "pane": 0, "type": "OptionsFlow" } },
      { "no_active_violations": true }
    ] },
    { "action": "log", "message": "Switching pane 0 back to Chart" },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 0, "kind": "Chart" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "pane_type_equals": { "pane": 0, "type": "Chart" } }
    ] },
    { "action": "reset" }
  ]
}
