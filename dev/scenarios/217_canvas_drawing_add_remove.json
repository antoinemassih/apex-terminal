{
  "name": "canvas_drawing_add_remove",
  "description": "Add a drawing, verify it exists, remove it, verify cleared",
  "story": "Canvas Introspection",
  "priority": 1,
  "tags": ["canvas", "drawings"],
  "steps": [
    {"action": "reset"},
    {"action": "wait", "ms": 30},
    {"action": "assert", "assertions": [
      {"canvas_no_drawings": {"pane": 0}}
    ]},
    {"action": "cmd", "cmd": "AddDrawing", "pane": 0,
     "id": "drawing.0", "kind": "HorizLine", "price_a": 455.0},
    {"action": "wait", "ms": 30},
    {"action": "assert", "assertions": [
      {"canvas_drawing_count_equals": {"pane": 0, "count": 1}},
      {"canvas_drawing_exists":       {"pane": 0, "id": "drawing.0"}},
      {"canvas_drawing_kind_count":   {"pane": 0, "kind": "HorizLine", "count": 1}}
    ]},
    {"action": "cmd", "cmd": "RemoveDrawing", "pane": 0, "id": "drawing.0"},
    {"action": "wait", "ms": 30},
    {"action": "assert", "assertions": [
      {"canvas_no_drawings": {"pane": 0}},
      {"canvas_drawing_count_equals": {"pane": 0, "count": 0}}
    ]}
  ]
}
