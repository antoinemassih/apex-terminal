{
  "name": "dialog_multiple_open",
  "description": "Open order_entry and orders_panel in sequence; assert both are tracked as open.",
  "story": "Dialog/Lifecycle",
  "tags": ["dialog"],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "OpenOrderEntry", "args": {} },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "dialog_open": "order_entry" }] },
    { "action": "cmd", "cmd": "OpenOrdersPanel", "args": {} },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [
      { "dialog_open": "order_entry" },
      { "dialog_open": "orders_panel" },
      { "fps_above": 5.0 }
    ]},
    { "action": "cmd", "cmd": "CloseOrderEntry", "args": {} },
    { "action": "cmd", "cmd": "CloseOrdersPanel", "args": {} },
    { "action": "reset" }
  ]
}
