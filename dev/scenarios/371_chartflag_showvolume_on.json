{
  "name": "chartflag_showvolume_on",
  "description": "ShowVolume on: no violations, FPS stable.",
  "story": "ChartFlag/Settings",
  "tags": [
    "chartflag"
  ],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "args": {
        "pane": 0,
        "symbol": "SPY"
      }
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SetChartFlag",
      "args": {
        "pane": 0,
        "flag": "ShowVolume",
        "value": true
      }
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "assert",
      "assertions": [
        {
          "fps_above": 5
        },
        {
          "no_active_violations": true
        }
      ]
    },
    {
      "action": "reset"
    }
  ]
}