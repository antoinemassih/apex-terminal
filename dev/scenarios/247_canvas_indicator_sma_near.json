{
  "name": "canvas_indicator_sma_near",
  "description": "SMA indicator last value is near the set value",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": [
    "canvas",
    "indicators"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "cmd",
      "cmd": "SetIndicatorOutput",
      "pane": 0,
      "kind": "SMA",
      "value": 449
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_indicator_last_value_near": {
            "pane": 0,
            "kind": "SMA",
            "value": 449,
            "tolerance": 0.01
          }
        },
        {
          "canvas_indicator_value_in_range": {
            "pane": 0,
            "kind": "SMA",
            "min": 448,
            "max": 450
          }
        }
      ]
    }
  ]
}