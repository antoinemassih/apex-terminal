{
  "name": "95_inter_pane_fps_all_active",
  "description": "Maximum multi-pane indicator load: Quad layout with 4 unique symbols and 2 indicators on each pane (8 indicators total). Assert fps_above 5.0 to confirm GPU pipeline holds.",
  "tags": ["inter-pane", "fps"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "Quad" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "SPY" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 1, "symbol": "QQQ" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 2, "symbol": "AAPL" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 3, "symbol": "NVDA" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "RSI" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "VWAP" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 1, "kind": "MACD" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 1, "kind": "BB" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 2, "kind": "EMA" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 2, "kind": "ATR" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 3, "kind": "SMA" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 3, "kind": "OBV" } },
    { "action": "wait_frames", "count": 12 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "no_active_violations": true }
    ] },
    { "action": "reset" }
  ]
}
