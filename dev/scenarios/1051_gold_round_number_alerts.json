{
  "name": "gold_round_number_alerts",
  "description": "Gold (GC) breakout and breakdown alerts at round-number levels.",
  "story": "Commodities/Alerts",
  "tags": [
    "story",
    "commodities",
    "gold",
    "alerts",
    "levels"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "Gold (GC) round-number alerts"
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "GC"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 0,
      "tf": "1d"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        },
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "GC"
          }
        },
        {
          "pane_timeframe_equals": {
            "pane": 0,
            "tf": "1d"
          }
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "AddPriceAlert",
      "pane": 0,
      "price": 2500.0,
      "above": true
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "AddPriceAlert",
      "pane": 0,
      "price": 2300.0,
      "above": false
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        },
        {
          "state_field_gte": {
            "path": "total_alert_count",
            "min": 1
          }
        }
      ]
    }
  ]
}