{
  "name": "bond_pair_zb_zn",
  "description": "ZB 30-year and ZN 10-year bond futures on independent timeframes (daily vs hourly).",
  "story": "MultiAsset/BondDesk",
  "tags": [
    "story",
    "multipane",
    "multiasset",
    "bonds",
    "futures"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "bond pair: pane0 ZB, pane1 ZN"
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "ZB"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 1,
      "symbol": "ZN"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "ZB"
          }
        },
        {
          "pane_symbol_equals": {
            "pane": 1,
            "symbol": "ZN"
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 1
          }
        },
        {
          "fps_above": 5.0
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 0,
      "tf": "1d"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 1,
      "tf": "1h"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "ZB"
          }
        },
        {
          "pane_symbol_equals": {
            "pane": 1,
            "symbol": "ZN"
          }
        },
        {
          "pane_timeframe_equals": {
            "pane": 0,
            "tf": "1d"
          }
        },
        {
          "pane_timeframe_equals": {
            "pane": 1,
            "tf": "1h"
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 1
          }
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}