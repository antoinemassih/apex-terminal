{
  "name": "canvas_hzone_anchors",
  "description": "HorizZone has two price anchors at the specified levels",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": [
    "canvas",
    "drawings",
    "anchors"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "zone1",
      "kind": "HorizZone",
      "price_a": 430,
      "price_b": 470
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_drawing_exists": {
            "pane": 0,
            "id": "zone1"
          }
        },
        {
          "canvas_drawing_anchor_count": {
            "pane": 0,
            "id": "zone1",
            "count": 2
          }
        },
        {
          "canvas_drawing_anchor_price_near": {
            "pane": 0,
            "id": "zone1",
            "anchor": 0,
            "price": 430,
            "tolerance": 0.01
          }
        },
        {
          "canvas_drawing_anchor_price_near": {
            "pane": 0,
            "id": "zone1",
            "anchor": 1,
            "price": 470,
            "tolerance": 0.01
          }
        }
      ]
    }
  ]
}
