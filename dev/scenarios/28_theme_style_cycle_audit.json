{
  "name": "theme_style_cycle_audit",
  "description": "User story: as a design-conscious user I cycle through style presets and theme indices. Each combination should leave the UI without contract violations and with acceptable FPS.",
  "tags": ["theme", "style", "design", "audit"],
  "settle_ms": 80,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 2 },
    { "action": "cmd", "cmd": "SetStyleIdx", "args": { "idx": 0 } },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "fps_above": 5.0 },
        { "no_active_violations": true }
      ]
    },
    { "action": "cmd", "cmd": "SetStyleIdx", "args": { "idx": 1 } },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "fps_above": 5.0 },
        { "no_active_violations": true },
        { "all_touch_targets_ok": true }
      ]
    },
    { "action": "cmd", "cmd": "SetStyleIdx", "args": { "idx": 2 } },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "fps_above": 5.0 },
        { "no_active_violations": true }
      ]
    },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "pane": 0, "idx": 1 } },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "fps_above": 5.0 },
        { "no_active_violations": true }
      ]
    },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "pane": 0, "idx": 2 } },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "fps_above": 5.0 },
        { "no_clipped_widgets": true }
      ]
    },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "pane": 0, "idx": 0 } },
    { "action": "cmd", "cmd": "SetStyleIdx", "args": { "idx": 0 } },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "fps_above": 5.0 },
        { "no_active_violations": true },
        { "all_touch_targets_ok": true }
      ]
    },
    { "action": "log", "message": "Theme/style cycle audit complete — 3 styles × 3 themes cycled, all design assertions passed." }
  ]
}
