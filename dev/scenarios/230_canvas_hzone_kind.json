{
  "name": "canvas_hzone_kind",
  "description": "HorizZone drawing appears in kind count",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": [
    "canvas",
    "drawings"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "zone1",
      "kind": "HorizZone",
      "price_a": 430,
      "price_b": 450
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_drawing_count_equals": {
            "pane": 0,
            "count": 1
          }
        },
        {
          "canvas_drawing_kind_count": {
            "pane": 0,
            "kind": "HorizZone",
            "count": 1
          }
        },
        {
          "canvas_drawing_exists": {
            "pane": 0,
            "id": "zone1"
          }
        }
      ]
    }
  ]
}