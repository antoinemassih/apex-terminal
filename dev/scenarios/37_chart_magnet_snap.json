{
  "name": "chart_magnet_snap",
  "description": "Toggle Magnet flag on and off, verify no FPS degradation or violations.",
  "story": "Chart/Settings",
  "tags": ["chart", "interaction"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "log", "message": "Enabling Magnet snap" },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "Magnet", "value": true } },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "log", "message": "Disabling Magnet snap" },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "Magnet", "value": false } },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] }
  ]
}
