{
  "name": "canvas_viewport_px_per_bar_baseline",
  "description": "px_per_bar is always positive in default state",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": [
    "canvas",
    "viewport"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_viewport_px_per_bar_gte": {
            "pane": 0,
            "min": 0.01
          }
        }
      ]
    }
  ]
}