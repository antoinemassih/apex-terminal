{
  "name": "129_qoe_fps_stress_all_features",
  "description": "Maximum combined load stress test: Quad layout, 5 indicators per pane (20 total), all chart flags enabled, rapid symbol changes across all panes. Assert fps_above 5.0 to confirm the GPU pipeline stays alive under peak feature activation.",
  "story": "QoE/Full",
  "tags": ["qoe", "fps", "stress"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "Quad" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "SPY" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 1, "symbol": "QQQ" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 2, "symbol": "AAPL" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 3, "symbol": "NVDA" } },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "ShowVolume", "value": true } },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "AutoScale", "value": true } },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "CrosshairEnabled", "value": true } },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "ShowPrevClose", "value": true } },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "ExtendedHours", "value": true } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "RSI" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "MACD" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "VWAP" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "EMA" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "BB" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 1, "kind": "RSI" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 1, "kind": "ATR" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 1, "kind": "SMA" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 1, "kind": "OBV" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 1, "kind": "STOCH" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 2, "kind": "RSI" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 2, "kind": "MACD" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 2, "kind": "Volume" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 2, "kind": "EMA" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 2, "kind": "BB" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 3, "kind": "VWAP" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 3, "kind": "ATR" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 3, "kind": "SMA" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 3, "kind": "STOCH" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 3, "kind": "OBV" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "TSLA" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 2, "symbol": "AMD" } },
    { "action": "wait_frames", "count": 15 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "no_active_violations": true }
    ] }
  ]
}
