{
  "name": "close_all_clears_every_dialog",
  "description": "Open all 4 dialogs (settings, order_entry, orders_panel, hotkey_editor). Assert 4 open. CloseAllDialogs. Assert none remain open.",
  "story": "Dialog/Lifecycle",
  "tags": ["dialogs", "lifecycle", "close-all"],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "cmd", "cmd": "OpenSettings", "args": {} },
    { "action": "cmd", "cmd": "OpenOrderEntry", "args": {} },
    { "action": "cmd", "cmd": "OpenOrdersPanel", "args": {} },
    { "action": "cmd", "cmd": "OpenHotkeyEditor", "args": {} },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "open_dialog_count_equals": 4 }
      ]
    },
    { "action": "cmd", "cmd": "CloseAllDialogs", "args": {} },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "no_open_dialogs": true },
        { "open_dialog_count_equals": 0 },
        { "fps_above": 5.0 }
      ]
    },
    { "action": "reset" }
  ]
}
