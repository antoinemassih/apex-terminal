{
  "name": "canvas_indicator_three_kinds",
  "description": "Three indicator kinds visible simultaneously — all exist",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": [
    "canvas",
    "indicators"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "cmd",
      "cmd": "SetIndicatorOutput",
      "pane": 0,
      "kind": "SMA",
      "value": 449
    },
    {
      "action": "cmd",
      "cmd": "SetIndicatorOutput",
      "pane": 0,
      "kind": "EMA",
      "value": 447
    },
    {
      "action": "cmd",
      "cmd": "SetIndicatorOutput",
      "pane": 0,
      "kind": "RSI",
      "value": 62
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_indicator_exists": {
            "pane": 0,
            "kind": "SMA"
          }
        },
        {
          "canvas_indicator_exists": {
            "pane": 0,
            "kind": "EMA"
          }
        },
        {
          "canvas_indicator_exists": {
            "pane": 0,
            "kind": "RSI"
          }
        },
        {
          "canvas_indicator_count_equals": {
            "pane": 0,
            "count": 3
          }
        }
      ]
    }
  ]
}
