{
  "name": "metals_desk_gold_silver",
  "description": "Precious-metals desk: GC gold in pane 0 and SI silver in pane 1 on the 4h timeframe.",
  "story": "MultiAsset/MacroDesk",
  "tags": [
    "story",
    "multipane",
    "multiasset",
    "futures",
    "commodity"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "metals desk: pane0 GC gold, pane1 SI silver"
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "GC"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 1,
      "symbol": "SI"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "GC"
          }
        },
        {
          "pane_symbol_equals": {
            "pane": 1,
            "symbol": "SI"
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 1
          }
        },
        {
          "fps_above": 5.0
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 0,
      "tf": "4h"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 1,
      "tf": "4h"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "GC"
          }
        },
        {
          "pane_symbol_equals": {
            "pane": 1,
            "symbol": "SI"
          }
        },
        {
          "pane_timeframe_equals": {
            "pane": 0,
            "tf": "4h"
          }
        },
        {
          "pane_timeframe_equals": {
            "pane": 1,
            "tf": "4h"
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 1
          }
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}