{
  "name": "grade_long_lost",
  "description": "Long play activates then hits stop -> Lost.",
  "story": "Playbook/Grading",
  "tags": [
    "playbook",
    "grading",
    "lifecycle"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SetPlaybookPanel",
      "open": true
    },
    {
      "action": "cmd",
      "cmd": "SeedPlay",
      "symbol": "GRLL",
      "long": true,
      "entry": 100.0,
      "target": 110.0,
      "stop": 95.0
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "playbook.plays.0.status",
            "value": "DRAFT"
          }
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "GradePlaysAtPrice",
      "symbol": "GRLL",
      "price": 101.0
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "log",
      "message": "GRLL @ 101.0 -> ACTIVE"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "playbook.plays.0.status",
            "value": "ACTIVE"
          }
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "GradePlaysAtPrice",
      "symbol": "GRLL",
      "price": 94.0
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "log",
      "message": "GRLL @ 94.0 -> LOST"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "playbook.plays.0.status",
            "value": "LOST"
          }
        }
      ]
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "no_live_orders": true
        }
      ]
    }
  ]
}