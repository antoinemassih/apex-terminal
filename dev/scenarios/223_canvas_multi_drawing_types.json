{
  "name": "canvas_multi_drawing_types",
  "description": "Add three drawings of mixed kinds and verify per-kind counts",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": ["canvas", "drawings"],
  "steps": [
    {"action": "reset"},
    {"action": "wait", "ms": 30},
    {"action": "cmd", "cmd": "AddDrawing", "pane": 0,
     "id": "hl1", "kind": "HorizLine", "price_a": 445.0},
    {"action": "cmd", "cmd": "AddDrawing", "pane": 0,
     "id": "hl2", "kind": "HorizLine", "price_a": 460.0},
    {"action": "cmd", "cmd": "AddDrawing", "pane": 0,
     "id": "tl1", "kind": "Trendline", "price_a": 440.0, "price_b": 465.0},
    {"action": "wait", "ms": 30},
    {"action": "assert", "assertions": [
      {"canvas_drawing_count_equals": {"pane": 0, "count": 3}},
      {"canvas_drawing_kind_count":   {"pane": 0, "kind": "HorizLine", "count": 2}},
      {"canvas_drawing_kind_count":   {"pane": 0, "kind": "Trendline", "count": 1}},
      {"canvas_drawing_exists":       {"pane": 0, "id": "hl1"}},
      {"canvas_drawing_exists":       {"pane": 0, "id": "hl2"}},
      {"canvas_drawing_exists":       {"pane": 0, "id": "tl1"}}
    ]}
  ]
}
