{
  "name": "reset",
  "description": "Verify POST /reset restores the app to a known clean baseline state.",
  "story": "Baseline/Health",
  "tags": ["smoke", "reset"],
  "settle_ms": 0,
  "abort_on_failure": true,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        { "no_open_dialogs": true },
        { "active_symbol_equals": "SPY" },
        { "active_timeframe_equals": "5m" }
      ]
    },
    {
      "action": "log",
      "message": "Reset scenario passed — baseline state confirmed."
    }
  ]
}
