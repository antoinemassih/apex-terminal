{
  "name": "reset_iso_order_btc_usd",
  "description": "After driving order on BTC-USD, reset returns a clean baseline (no contamination).",
  "story": "Harness/ResetIsolation",
  "tags": [
    "harness",
    "reset",
    "isolation"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "BTC-USD"
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SeedDraftOrder",
      "pane": 0,
      "side": "buy",
      "price": 100.0,
      "qty": 100
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "drive order then reset BTC-USD"
    },
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "panes.0.order_count",
            "value": 0
          }
        },
        {
          "no_live_orders": true
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        }
      ]
    }
  ]
}