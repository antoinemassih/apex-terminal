{
  "name": "googl_daily_supertrend",
  "description": "Swing trader rides the GOOGL daily trend with the Supertrend indicator.",
  "story": "SwingTrading/TrendFollowing",
  "tags": [
    "story",
    "swing",
    "supertrend",
    "trend"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "GOOGL daily Supertrend trend-following"
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "GOOGL"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        },
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "GOOGL"
          }
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 0,
      "tf": "1d"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        },
        {
          "pane_timeframe_equals": {
            "pane": 0,
            "tf": "1d"
          }
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "pane": 0,
      "kind": "ST"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        },
        {
          "canvas_indicator_exists": {
            "pane": 0,
            "kind": "ST"
          }
        },
        {
          "canvas_visible_bar_count_gte": {
            "pane": 0,
            "min": 1
          }
        }
      ]
    }
  ]
}