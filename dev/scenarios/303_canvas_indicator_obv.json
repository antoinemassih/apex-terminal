{
  "name": "canvas_indicator_obv",
  "description": "OBV reports large integer volume accumulation",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": ["canvas", "indicators"],
  "steps": [
    {"action": "reset"},
    {"action": "wait", "ms": 30},
    {"action": "cmd", "cmd": "SetIndicatorOutput", "pane": 0, "kind": "OBV", "value": 5000000},
    {"action": "wait", "ms": 30},
    {"action": "assert", "assertions": [
      {"canvas_indicator_exists": {"pane": 0, "kind": "OBV"}},
      {"canvas_indicator_value_in_range": {"pane": 0, "kind": "OBV", "min": 0, "max": 100000000}}
    ]}
  ]
}
