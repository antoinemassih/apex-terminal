{
  "name": "reset_clears_indicators",
  "description": "Add 5 different indicators to pane 0. Assert count is 5. Reset. Assert indicator count returns to 0.",
  "story": "Reset/Integrity",
  "tags": ["reset", "indicators", "integrity"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "RSI" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "MACD" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "EMA" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "ATR" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "VWAP" } },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "indicator_count_equals": { "pane": 0, "count": 5 } }
      ]
    },
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    {
      "action": "assert",
      "assertions": [
        { "indicator_count_equals": { "pane": 0, "count": 0 } },
        { "fps_above": 5.0 }
      ]
    }
  ]
}
