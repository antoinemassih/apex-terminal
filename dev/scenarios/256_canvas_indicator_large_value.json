{
  "name": "canvas_indicator_large_value",
  "description": "Large VWAP-style value tracked without precision loss",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": [
    "canvas",
    "indicators"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "cmd",
      "cmd": "SetIndicatorOutput",
      "pane": 0,
      "kind": "VWAP",
      "value": 50000
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_indicator_value_in_range": {
            "pane": 0,
            "kind": "VWAP",
            "min": 49900,
            "max": 50100
          }
        }
      ]
    }
  ]
}