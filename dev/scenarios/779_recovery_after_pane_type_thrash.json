{
  "name": "recovery_after_pane_type_thrash",
  "description": "Thrash a pane through pane types with no settle, then reset and load a clean liquid chart, giving a generous settle to confirm full recovery and convergence.",
  "story": "Recovery/PaneTypeThrash",
  "tags": [
    "story",
    "recovery",
    "stress",
    "panetype"
  ],
  "priority": 2,
  "settle_ms": 10,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "TSLA"
    },
    {
      "action": "wait",
      "ms": 600
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "ChangePaneType",
      "pane": 0,
      "kind": "Heatmap"
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "ChangePaneType",
      "pane": 0,
      "kind": "OptionsFlow"
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "ChangePaneType",
      "pane": 0,
      "kind": "Dashboard"
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "ChangePaneType",
      "pane": 0,
      "kind": "Spreadsheet"
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "ChangePaneType",
      "pane": 0,
      "kind": "Portfolio"
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "ChangePaneType",
      "pane": 0,
      "kind": "OptionsSentiment"
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "ChangePaneType",
      "pane": 0,
      "kind": "Heatmap"
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "ChangePaneType",
      "pane": 0,
      "kind": "Chart"
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "ChangePaneType",
      "pane": 0,
      "kind": "Dashboard"
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "ChangePaneType",
      "pane": 0,
      "kind": "Chart"
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        }
      ]
    },
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "SPY"
    },
    {
      "action": "wait",
      "ms": 1500
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 0,
      "tf": "5m"
    },
    {
      "action": "wait",
      "ms": 1500
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_type_equals": {
            "pane": 0,
            "type": "Chart"
          }
        },
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "SPY"
          }
        },
        {
          "pane_timeframe_equals": {
            "pane": 0,
            "tf": "5m"
          }
        },
        {
          "canvas_visible_bar_count_gte": {
            "pane": 0,
            "min": 1
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 3.0
        }
      ]
    }
  ]
}