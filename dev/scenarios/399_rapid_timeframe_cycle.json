{
  "name": "rapid_timeframe_cycle",
  "description": "Cycle through all 8 timeframes on pane 0 via for_each. After cycling, assert OHLC valid and FPS acceptable.",
  "story": "StressTest/Mutations",
  "tags": ["stress-test", "timeframe", "rapid", "for-each"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "for_each",
      "var": "tf",
      "items": ["1m", "5m", "15m", "30m", "1h", "4h", "1d", "1wk"],
      "steps": [
        { "action": "cmd", "cmd": "ChangeTimeframe", "args": { "pane": 0, "tf": "{{tf}}" } },
        { "action": "wait_frames", "count": 2 }
      ]
    },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "canvas_bar_ohlc_valid": { "pane": 0 } },
        { "fps_above": 5.0 }
      ]
    },
    { "action": "reset" }
  ]
}
