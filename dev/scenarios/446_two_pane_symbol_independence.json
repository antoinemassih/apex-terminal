{
  "name": "two_pane_symbol_independence",
  "description": "Two-pane layout; set different symbols on each pane and verify each pane tracks its own symbol.",
  "story": "Layout/MultiSymbol",
  "tags": ["layout", "symbol", "multi_pane"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "TwoColumns" } },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "pane_count_equals": 2 }] },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "SPY" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 1, "symbol": "QQQ" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [
      { "pane_symbol_equals": { "pane": 0, "symbol": "SPY" } },
      { "pane_symbol_equals": { "pane": 1, "symbol": "QQQ" } },
      { "fps_above": 5.0 },
      { "no_active_violations": true }
    ] },
    { "action": "reset" }
  ]
}
