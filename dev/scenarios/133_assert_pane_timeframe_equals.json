{
  "name": "assert_pane_timeframe_equals",
  "description": "Tests pane_timeframe_equals by assigning distinct timeframes to two panes.",
  "story": "TestInfra/AssertEngine",
  "tags": ["assert-engine", "per-pane"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 2 },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "TwoColumns" } },
    { "action": "wait_frames", "count": 2 },
    { "action": "log", "message": "Setting pane 0 tf=1m, pane 1 tf=1h" },
    { "action": "cmd", "cmd": "ChangeTimeframe", "args": { "pane": 0, "tf": "1m" } },
    { "action": "cmd", "cmd": "ChangeTimeframe", "args": { "pane": 1, "tf": "1h" } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [
      { "pane_count_equals": 2 },
      { "pane_timeframe_equals": { "pane": 0, "tf": "1m" } },
      { "pane_timeframe_equals": { "pane": 1, "tf": "1h" } }
    ]},
    { "action": "log", "message": "pane_timeframe_equals assertions passed for both panes" }
  ]
}
