{
  "name": "pane_indicator_isolation_basic",
  "description": "Add RSI to pane 0 only. Assert pane 0 has 1 indicator and pane 1 has 0. Core isolation check.",
  "story": "MultiPane/Indicators",
  "tags": ["multi-pane", "indicators", "isolation"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "TwoColumns" } },
    { "action": "wait_frames", "count": 3 },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "RSI" } },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "indicator_count_equals": { "pane": 0, "count": 1 } },
        { "indicator_count_equals": { "pane": 1, "count": 0 } },
        { "fps_above": 5.0 }
      ]
    },
    { "action": "reset" }
  ]
}
