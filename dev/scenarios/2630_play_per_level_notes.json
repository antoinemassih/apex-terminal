{
  "name": "play_per_level_notes",
  "description": "Per-level notes: entry and stop carry their own rationale, distinct from the overall thesis.",
  "story": "Playbook/RichLevels",
  "tags": [
    "playbook",
    "notes",
    "authoring"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SetPlaybookPanel",
      "open": true
    },
    {
      "action": "cmd",
      "cmd": "SeedPlay",
      "symbol": "NOTE1",
      "long": true,
      "entry": 100.0,
      "target": 110.0,
      "stop": 95.0
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "playbook.plays.0.entry_note",
            "value": ""
          }
        },
        {
          "state_field_equals": {
            "path": "playbook.plays.0.stop_note",
            "value": ""
          }
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "SetPlayNote",
      "idx": 0,
      "which": "entry",
      "note": "buying the retest of the breakout"
    },
    {
      "action": "cmd",
      "cmd": "SetPlayNote",
      "idx": 0,
      "which": "stop",
      "note": "below the swing low; thesis wrong if lost"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "log",
      "message": "per-level rationale set"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "playbook.plays.0.entry_note",
            "value": "buying the retest of the breakout"
          }
        },
        {
          "state_field_equals": {
            "path": "playbook.plays.0.stop_note",
            "value": "below the swing low; thesis wrong if lost"
          }
        },
        {
          "no_panic": true
        }
      ]
    }
  ]
}