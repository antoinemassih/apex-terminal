{
  "name": "index_leaders_health_check",
  "description": "Leaders health check: QQQ 15m oscillators+MACD, then AVGO and GOOGL.",
  "story": "Risk/HealthCheck",
  "tags": [
    "story",
    "playbook",
    "leaders",
    "breadth",
    "invariants"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "Index leaders health check: QQQ + leaders, oscillators, MACD"
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "QQQ"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 0,
      "tf": "15m"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "SetChartFlag",
      "pane": 0,
      "flag": "ShowOscillators",
      "value": true
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "pane": 0,
      "kind": "MACD"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "QQQ"
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "AVGO"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "AVGO"
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "GOOGL"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "RecomputeIndicators",
      "pane": 0
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "GOOGL"
          }
        },
        {
          "canvas_indicator_exists": {
            "pane": 0,
            "kind": "MACD"
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}