{
  "name": "chart_prev_close_line",
  "description": "Enable ShowPrevClose flag and verify rendering stability and FPS.",
  "tags": ["chart", "flags"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "log", "message": "Enabling ShowPrevClose" },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "ShowPrevClose", "value": true } },
    { "action": "wait_frames", "count": 4 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "snapshot", "name": "prev_close_enabled" },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "ShowPrevClose", "value": false } },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] }
  ]
}
