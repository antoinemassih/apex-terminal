{
  "name": "order_entry_and_orders_panel",
  "description": "Open order entry and orders panel simultaneously, verify both dialogs are tracked as open, then close all.",
  "story": "OrderEntry/MultiDialog",
  "tags": ["order_entry", "orders_panel", "dialog"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "no_open_dialogs": true }] },
    { "action": "log", "message": "Opening order entry" },
    { "action": "cmd", "cmd": "OpenOrderEntry", "args": {} },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "dialog_open": "order_entry" }] },
    { "action": "log", "message": "Opening orders panel alongside order entry" },
    { "action": "cmd", "cmd": "OpenOrdersPanel", "args": {} },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [
      { "dialog_open": "order_entry" },
      { "dialog_open": "orders_panel" },
      { "fps_above": 5.0 }
    ] },
    { "action": "log", "message": "Closing all dialogs" },
    { "action": "cmd", "cmd": "CloseAllDialogs", "args": {} },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [
      { "no_open_dialogs": true },
      { "fps_above": 5.0 }
    ] },
    { "action": "reset" }
  ]
}
