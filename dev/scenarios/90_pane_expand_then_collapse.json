{
  "name": "90_pane_expand_then_collapse",
  "description": "Single→Quad→Single layout cycle, checking FPS and pane counts at each transition to ensure no render pipeline disruption.",
  "tags": ["pane", "layout", "fps"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 }, { "pane_count_equals": 1 } ] },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "Quad" } },
    { "action": "wait_frames", "count": 8 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 }, { "pane_count_equals": 4 } ] },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "SPY" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 2, "symbol": "NVDA" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 } ] },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "Single" } },
    { "action": "wait_frames", "count": 8 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "pane_count_equals": 1 },
      { "no_active_violations": true },
      { "no_clipped_widgets": true }
    ] }
  ]
}
