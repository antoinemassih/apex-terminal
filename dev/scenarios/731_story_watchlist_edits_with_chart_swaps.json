{
  "name": "story_watchlist_edits_with_chart_swaps",
  "description": "Trader interleaves watchlist add/remove with chart symbol swaps in one workflow.",
  "story": "Scanning/MixedWorkflow",
  "tags": [
    "story",
    "watchlist",
    "scan",
    "mixed"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "Interleave watchlist edits with chart symbol swaps"
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "AAPL"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "AAPL"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        },
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "AAPL"
          }
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "NVDA"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "NVDA"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        },
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "NVDA"
          }
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "WatchlistRemoveSymbol",
      "symbol": "AAPL"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "MSFT"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        },
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "MSFT"
          }
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "MSFT"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}