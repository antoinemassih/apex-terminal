{
  "name": "102_qoe_theme_cycle_all",
  "description": "Cycle through all 9 theme indices (0-8), asserting fps_above 5.0 after each switch to confirm theme repaints never block the render pipeline.",
  "story": "QoE/Full",
  "tags": ["qoe", "theme"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "SPY" } },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "idx": 0 } },
    { "action": "wait_frames", "count": 4 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 } ] },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "idx": 1 } },
    { "action": "wait_frames", "count": 4 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 } ] },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "idx": 2 } },
    { "action": "wait_frames", "count": 4 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 } ] },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "idx": 3 } },
    { "action": "wait_frames", "count": 4 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 } ] },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "idx": 4 } },
    { "action": "wait_frames", "count": 4 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 } ] },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "idx": 5 } },
    { "action": "wait_frames", "count": 4 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 } ] },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "idx": 6 } },
    { "action": "wait_frames", "count": 4 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 } ] },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "idx": 7 } },
    { "action": "wait_frames", "count": 4 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 } ] },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "idx": 8 } },
    { "action": "wait_frames", "count": 4 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 }, { "no_active_violations": true } ] }
  ]
}
