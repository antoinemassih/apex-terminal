{
  "name": "order_close_resets_dialog_state",
  "description": "Open and close order entry, verify no_open_dialogs assertion is satisfied after close.",
  "tags": ["order", "dialog"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_open_dialogs": true }] },
    { "action": "log", "message": "Opening order entry" },
    { "action": "cmd", "cmd": "OpenOrderEntry", "args": {} },
    { "action": "wait_frames", "count": 4 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "log", "message": "Closing all dialogs" },
    { "action": "cmd", "cmd": "CloseAllDialogs", "args": {} },
    { "action": "wait_frames", "count": 4 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "no_open_dialogs": true },
      { "no_active_violations": true }
    ]}
  ]
}
