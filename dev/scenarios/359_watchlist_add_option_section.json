{
  "name": "watchlist_add_option_section",
  "description": "WatchlistAddOptionSection creates an options section; section count increases.",
  "story": "Watchlist/CRUD",
  "tags": [
    "watchlist",
    "section",
    "options"
  ],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "assert",
      "assertions": [
        {
          "watchlist_section_count_equals": 1
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddOptionSection",
      "args": {
        "title": "Options Flow"
      }
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "watchlist_section_count_equals": 2
        },
        {
          "fps_above": 5
        }
      ]
    },
    {
      "action": "reset"
    }
  ]
}