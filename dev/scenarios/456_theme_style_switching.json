{
  "name": "theme_style_switching",
  "description": "Cycle through theme indices 0-4 and style indices 0-3, verifying no crashes or violations at each step.",
  "story": "Settings/ThemeStyleCycle",
  "tags": ["settings", "theme", "style"],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "log", "message": "Cycle through themes 0-4" },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "pane": 0, "idx": 0 } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "pane": 0, "idx": 1 } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "pane": 0, "idx": 2 } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "pane": 0, "idx": 3 } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "pane": 0, "idx": 4 } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "log", "message": "Cycle through styles 0-3" },
    { "action": "cmd", "cmd": "SetStyleIdx", "args": { "idx": 0 } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "cmd", "cmd": "SetStyleIdx", "args": { "idx": 1 } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "cmd", "cmd": "SetStyleIdx", "args": { "idx": 2 } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "cmd", "cmd": "SetStyleIdx", "args": { "idx": 3 } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "log", "message": "Return to default theme 0, style 0" },
    { "action": "cmd", "cmd": "SetThemeIdx", "args": { "pane": 0, "idx": 0 } },
    { "action": "cmd", "cmd": "SetStyleIdx", "args": { "idx": 0 } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "reset" }
  ]
}
