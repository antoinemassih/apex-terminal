{
  "name": "97_inter_pane_options_in_layout",
  "description": "TwoColumns layout mixing a Chart pane and an OptionsSentiment pane on the same underlying symbol AAPL, verifying both render concurrently without FPS degradation.",
  "tags": ["inter-pane", "options"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "TwoColumns" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "pane_count_equals": 2 } ] },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 0, "kind": "Chart" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "AAPL" } },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 1, "kind": "OptionsSentiment" } },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 1, "symbol": "AAPL" } },
    { "action": "wait_frames", "count": 10 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "pane_type_equals": { "pane": 0, "type": "Chart" } },
      { "pane_type_equals": { "pane": 1, "type": "OptionsSentiment" } },
      { "no_active_violations": true },
      { "no_clipped_widgets": true }
    ] }
  ]
}
