{
  "name": "canvas_bars_after_drawing_added",
  "description": "Bar data remains valid after multiple drawings are added",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": [
    "canvas",
    "bars",
    "drawings"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "a",
      "kind": "HorizLine",
      "price_a": 430
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "b",
      "kind": "HorizLine",
      "price_a": 440
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "c",
      "kind": "HorizLine",
      "price_a": 450
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "canvas_visible_bar_count_gte": {
            "pane": 0,
            "min": 1
          }
        },
        {
          "canvas_drawing_count_equals": {
            "pane": 0,
            "count": 3
          }
        }
      ]
    }
  ]
}
