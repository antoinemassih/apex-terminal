{
  "name": "heatmap_seed_10",
  "description": "Heatmap pane with 10 seeded cells (cap 200) renders correctly.",
  "story": "Heatmap/Cells",
  "tags": [
    "heatmap",
    "correctness"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SeedHeatmapCells",
      "count": 10
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "ChangePaneType",
      "pane": 0,
      "kind": "Heatmap"
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "log",
      "message": "heatmap 10 cells"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "heatmap.cell_count",
            "value": 10
          }
        },
        {
          "pane_type_equals": {
            "pane": 0,
            "type": "Heatmap"
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}