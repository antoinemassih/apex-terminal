{
  "name": "watchlist_pct_fields",
  "description": "Add multiple symbols to the watchlist and verify stable fps and no violations. The watchlist % calculation path (live change vs close-to-close) must not produce NaN or panic under various market status conditions.",
  "story": "Watchlist/PctChange",
  "tags": ["watchlist", "price", "pct"],
  "settle_ms": 40,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "log", "message": "Add symbols that will trigger % change calculations" },
    { "action": "cmd", "cmd": "WatchlistAddSymbol", "args": { "symbol": "SPY" } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "cmd", "cmd": "WatchlistAddSymbol", "args": { "symbol": "QQQ" } },
    { "action": "cmd", "cmd": "WatchlistAddSymbol", "args": { "symbol": "AAPL" } },
    { "action": "cmd", "cmd": "WatchlistAddSymbol", "args": { "symbol": "TSLA" } },
    { "action": "cmd", "cmd": "WatchlistAddSymbol", "args": { "symbol": "NVDA" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "log", "message": "Verify watchlist renders all 5 items without crash" },
    { "action": "wait_frames", "count": 10 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "log", "message": "Remove symbols cleanly" },
    { "action": "cmd", "cmd": "WatchlistRemoveSymbol", "args": { "symbol": "SPY" } },
    { "action": "cmd", "cmd": "WatchlistRemoveSymbol", "args": { "symbol": "QQQ" } },
    { "action": "cmd", "cmd": "WatchlistRemoveSymbol", "args": { "symbol": "AAPL" } },
    { "action": "cmd", "cmd": "WatchlistRemoveSymbol", "args": { "symbol": "TSLA" } },
    { "action": "cmd", "cmd": "WatchlistRemoveSymbol", "args": { "symbol": "NVDA" } },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "reset" }
  ]
}
