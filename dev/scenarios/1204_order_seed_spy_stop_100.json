{
  "name": "order_seed_spy_stop_100",
  "description": "Seed a stop 100 DRAFT on SPY (no submit), then cancel-clean; paper-safe.",
  "story": "Trading/Orders",
  "tags": [
    "orders",
    "safe",
    "correctness"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "SPY"
    },
    {
      "action": "wait",
      "ms": 900
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SeedDraftOrder",
      "pane": 0,
      "side": "stop",
      "price": 123.45,
      "qty": 100
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "log",
      "message": "seed stop 100 SPY"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_gte": {
            "path": "panes.0.order_draft_count",
            "min": 1
          }
        },
        {
          "order_matches": {
            "pane": 0,
            "side": "Stop",
            "price": 123.45,
            "qty": 100
          }
        },
        {
          "no_live_orders": true
        },
        {
          "no_panic": true
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "CancelAllOrders"
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "panes.0.order_count",
            "value": 0
          }
        },
        {
          "no_live_orders": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}