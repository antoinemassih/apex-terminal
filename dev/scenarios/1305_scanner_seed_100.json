{
  "name": "scanner_seed_100",
  "description": "Scanner seeded with 100 rows (cap 500) filters and displays correctly.",
  "story": "Scanner/Results",
  "tags": [
    "scanner",
    "correctness"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SeedScannerResults",
      "count": 100
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "SetScannerOpen",
      "open": true
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "scanner 100 rows"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "scanner.result_count",
            "value": 100
          }
        },
        {
          "state_field_equals": {
            "path": "scanner.open",
            "value": true
          }
        },
        {
          "scanner_filter_correct": true
        },
        {
          "no_panic": true
        },
        {
          "fps_above": 5.0
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "SetScannerOpen",
      "open": false
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "scanner.open",
            "value": false
          }
        },
        {
          "no_panic": true
        }
      ]
    }
  ]
}