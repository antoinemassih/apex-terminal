{
  "name": "watchlist_add_remove_symbol",
  "description": "Add SPY then remove it: item_count returns to original level.",
  "story": "Watchlist/CRUD",
  "tags": [
    "watchlist",
    "symbol"
  ],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "args": {
        "symbol": "TESTX"
      }
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_gte": {
            "path": "watchlist.sections.0.item_count",
            "min": 1
          }
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "WatchlistRemoveSymbol",
      "args": {
        "symbol": "TESTX"
      }
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "assert",
      "assertions": [
        {
          "fps_above": 5
        },
        {
          "no_active_violations": true
        }
      ]
    },
    {
      "action": "reset"
    }
  ]
}