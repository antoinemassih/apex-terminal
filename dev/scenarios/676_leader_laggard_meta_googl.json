{
  "name": "leader_laggard_meta_googl",
  "description": "Compare META leader vs GOOGL laggard with RSI in two panes.",
  "story": "DayTrading/MultiPane",
  "tags": [
    "story",
    "daytrading",
    "multipane",
    "meta",
    "googl",
    "rsi"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "Leader-laggard: META pane 0, GOOGL pane 1 with RSI"
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "META"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 0,
      "tf": "5m"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "pane": 0,
      "kind": "RSI"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 1,
      "symbol": "GOOGL"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 1,
      "tf": "5m"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "pane": 1,
      "kind": "RSI"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "META"
          }
        },
        {
          "pane_symbol_equals": {
            "pane": 1,
            "symbol": "GOOGL"
          }
        },
        {
          "canvas_indicator_value_in_range": {
            "pane": 0,
            "kind": "RSI",
            "min": 0,
            "max": 100
          }
        },
        {
          "canvas_indicator_value_in_range": {
            "pane": 1,
            "kind": "RSI",
            "min": 0,
            "max": 100
          }
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 1
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}