{
  "name": "panetype_portfolio",
  "description": "Switch pane 0 to Portfolio type, assert pane_type_equals Portfolio, FPS stable.",
  "story": "PaneType/Switching",
  "tags": [
    "pane",
    "panetype"
  ],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "cmd",
      "cmd": "ChangePaneType",
      "args": {
        "pane": 0,
        "kind": "Portfolio"
      }
    },
    {
      "action": "wait_frames",
      "count": 6
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_type_equals": {
            "pane": 0,
            "type": "Portfolio"
          }
        },
        {
          "fps_above": 5
        },
        {
          "no_active_violations": true
        }
      ]
    },
    {
      "action": "reset"
    }
  ]
}