{
  "name": "pane1_independence_tsla",
  "description": "Pane 1 independently loads TSLA @15m with EMA while pane 0 is untouched.",
  "story": "Chart/MultiPane",
  "tags": [
    "multipane",
    "pane1",
    "invariants"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 1,
      "symbol": "TSLA"
    },
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 1,
      "tf": "15m"
    },
    {
      "action": "wait",
      "ms": 900
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "pane": 1,
      "kind": "EMA"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "RecomputeIndicators",
      "pane": 1
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "pane1 TSLA 15m EMA"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_symbol_equals": {
            "pane": 1,
            "symbol": "TSLA"
          }
        },
        {
          "pane_timeframe_equals": {
            "pane": 1,
            "tf": "15m"
          }
        },
        {
          "canvas_indicator_exists": {
            "pane": 1,
            "kind": "EMA"
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 1
          }
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}