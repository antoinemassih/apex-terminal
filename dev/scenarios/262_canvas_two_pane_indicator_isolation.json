{
  "name": "canvas_two_pane_indicator_isolation",
  "description": "Indicator on pane 0 does not bleed to pane 1",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": [
    "canvas",
    "indicators",
    "pane"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "cmd",
      "cmd": "HeadlessLayout",
      "cols": 2
    },
    {
      "action": "wait",
      "ms": 50
    },
    {
      "action": "cmd",
      "cmd": "SetIndicatorOutput",
      "pane": 0,
      "kind": "SMA",
      "value": 449
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_indicator_exists": {
            "pane": 0,
            "kind": "SMA"
          }
        },
        {
          "canvas_no_indicators": {
            "pane": 1
          }
        }
      ]
    }
  ]
}