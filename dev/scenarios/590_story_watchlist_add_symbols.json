{
  "name": "story_watchlist_add_symbols",
  "description": "Trader builds a watchlist of five symbols; % column populates and is sane.",
  "story": "Watchlist/CRUD",
  "tags": [
    "story",
    "watchlist"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "SPY"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "QQQ"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "AAPL"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "NVDA"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "TSLA"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "wait",
      "ms": 2000
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "fps_above": 5.0
        },
        {
          "watchlist_pct_present": true
        },
        {
          "watchlist_pct_sane": 25.0
        }
      ]
    }
  ]
}