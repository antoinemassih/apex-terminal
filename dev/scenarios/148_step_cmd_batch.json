{
  "name": "step_cmd_batch",
  "description": "Tests cmd_batch by issuing 3 AddIndicator commands and a symbol change in a single batch, then asserting all effects applied.",
  "tags": ["step-actions", "cmd-batch"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 2 },
    {
      "action": "assert",
      "assertions": [
        { "indicator_count_equals": 0 },
        { "pane_count_equals": 1 }
      ]
    },
    { "action": "log", "message": "Issuing cmd_batch: symbol change + 3 indicators in one shot." },
    {
      "action": "cmd_batch",
      "commands": [
        { "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "NVDA" } },
        { "cmd": "AddIndicator", "args": { "pane": 0, "kind": "RSI" } },
        { "cmd": "AddIndicator", "args": { "pane": 0, "kind": "VWAP" } },
        { "cmd": "AddIndicator", "args": { "pane": 0, "kind": "MACD" } }
      ]
    },
    { "action": "wait_frames", "count": 2 },
    {
      "action": "assert",
      "assertions": [
        { "indicator_count_equals": 3 },
        { "active_symbol_equals": "NVDA" },
        { "fps_above": 5.0 },
        { "no_active_violations": true }
      ]
    },
    { "action": "log", "message": "cmd_batch step action verified — symbol and 3 indicators applied atomically." }
  ]
}
