{
  "name": "109_qoe_fps_10_indicators",
  "description": "Maximum single-pane indicator load: all 10 indicator types (RSI+MACD+VWAP+BB+ATR+EMA+SMA+STOCH+OBV+Volume) on pane 0, assert fps_above 5.0.",
  "tags": ["qoe", "fps", "indicators"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "SPY" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "RSI" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "MACD" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "VWAP" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "BB" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "ATR" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "EMA" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "SMA" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "STOCH" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "OBV" } },
    { "action": "cmd", "cmd": "AddIndicator", "args": { "pane": 0, "kind": "Volume" } },
    { "action": "wait_frames", "count": 12 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "indicator_count_equals": 10 },
      { "no_active_violations": true }
    ] }
  ]
}
