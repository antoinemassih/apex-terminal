{
  "name": "timeframe_4h",
  "description": "Switch active pane to 4h timeframe, assert pane_timeframe_equals \"4h\".",
  "story": "Timeframe/Switching",
  "tags": [
    "timeframe"
  ],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "args": {
        "pane": 0,
        "symbol": "SPY"
      }
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "args": {
        "pane": 0,
        "tf": "4h"
      }
    },
    {
      "action": "wait_frames",
      "count": 6
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_timeframe_equals": {
            "pane": 0,
            "tf": "4h"
          }
        },
        {
          "fps_above": 5
        },
        {
          "no_active_violations": true
        }
      ]
    },
    {
      "action": "reset"
    }
  ]
}