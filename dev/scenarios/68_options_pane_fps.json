{
  "name": "options_pane_fps",
  "description": "Switch to OptionsSentiment pane, wait for settle, assert FPS stays above 5.",
  "tags": ["options", "fps"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "log", "message": "Switching to OptionsSentiment" },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 0, "kind": "OptionsSentiment" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] }
  ]
}
