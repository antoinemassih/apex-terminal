{
  "name": "visual_states_capture",
  "description": "Capture screenshots of key visual states (indicators, gamma) for review.",
  "story": "Design/Visual",
  "tags": [
    "visual",
    "screenshot"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "NVDA"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "pane": 0,
      "kind": "VWAP"
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "pane": 0,
      "kind": "RSI"
    },
    {
      "action": "cmd",
      "cmd": "RecomputeIndicators",
      "pane": 0
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "screenshot",
      "name": "nvda_vwap_rsi"
    },
    {
      "action": "cmd",
      "cmd": "SetChartFlag",
      "pane": 0,
      "flag": "ShowGamma",
      "value": true
    },
    {
      "action": "wait",
      "ms": 2000
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "screenshot",
      "name": "nvda_gamma_on"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        }
      ]
    }
  ]
}