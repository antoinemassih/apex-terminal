{
  "name": "103_qoe_style_cycle",
  "description": "Cycle SetStyleIdx 0→1→2→0, asserting fps_above after each change to verify style transitions are smooth.",
  "story": "QoE/Full",
  "tags": ["qoe", "style"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SwapPaneSymbol", "args": { "pane": 0, "symbol": "SPY" } },
    { "action": "cmd", "cmd": "SetStyleIdx", "args": { "idx": 0 } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 } ] },
    { "action": "cmd", "cmd": "SetStyleIdx", "args": { "idx": 1 } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 } ] },
    { "action": "cmd", "cmd": "SetStyleIdx", "args": { "idx": 2 } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "fps_above": 5.0 } ] },
    { "action": "cmd", "cmd": "SetStyleIdx", "args": { "idx": 0 } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "no_active_violations": true },
      { "no_clipped_widgets": true }
    ] }
  ]
}
