{
  "name": "canvas_drawing_trendline_count",
  "description": "Two trendlines counted correctly by kind",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": [
    "canvas",
    "drawings"
  ],
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "t1",
      "kind": "Trendline",
      "price_a": 430,
      "price_b": 450
    },
    {
      "action": "cmd",
      "cmd": "AddDrawing",
      "pane": 0,
      "id": "t2",
      "kind": "Trendline",
      "price_a": 445,
      "price_b": 460
    },
    {
      "action": "wait",
      "ms": 30
    },
    {
      "action": "assert",
      "assertions": [
        {
          "canvas_drawing_count_equals": {
            "pane": 0,
            "count": 2
          }
        },
        {
          "canvas_drawing_kind_count": {
            "pane": 0,
            "kind": "Trendline",
            "count": 2
          }
        }
      ]
    }
  ]
}