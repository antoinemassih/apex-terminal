{
  "name": "matrix1d_rrg_zb",
  "description": "ZB @1d: rrg subsystem drives + observes correctly on the daily.",
  "story": "Matrix1d/Rrg",
  "tags": [
    "matrix",
    "rrg",
    "timeframe"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "ZB"
    },
    {
      "action": "wait",
      "ms": 900
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 0,
      "tf": "1d"
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SetRrgOpen",
      "open": true
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "log",
      "message": "rrg ZB 1d"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "rrg.sector_count",
            "value": 11
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}