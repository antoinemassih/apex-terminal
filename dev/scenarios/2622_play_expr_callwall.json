{
  "name": "play_expr_callwall",
  "description": "An inline 'callwall' expression resolves a level to the chart's gamma call wall.",
  "story": "Playbook/RichLevels",
  "tags": [
    "playbook",
    "expression",
    "gamma",
    "authoring"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "SPY"
    },
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SynthGamma",
      "pane": 0
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SetPlaybookPanel",
      "open": true
    },
    {
      "action": "cmd",
      "cmd": "SeedPlay",
      "symbol": "SPY",
      "long": true,
      "entry": 100.0,
      "target": 110.0,
      "stop": 95.0
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "SetPlayLevelExpr",
      "idx": 0,
      "which": "target",
      "expr": "callwall"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "log",
      "message": "target resolved to SPY gamma call wall"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_gte": {
            "path": "playbook.plays.0.target",
            "min": 200.0
          }
        },
        {
          "no_panic": true
        }
      ]
    }
  ]
}