{
  "name": "multi_tf_ta_workup",
  "description": "Trader performs a full TA workup on one symbol across 1h, 4h and 1d timeframes.",
  "story": "TA/MultiTimeframe",
  "tags": [
    "story",
    "ta",
    "multitf",
    "workup"
