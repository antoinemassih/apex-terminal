{
  "name": "options_chart_combo",
  "description": "Quad layout with pane 0=Chart, pane 1=OptionsSentiment, pane 2=Chart, pane 3=OptionsFlow; assert 4 panes and stable fps.",
  "story": "OptionsChain/Layout",
  "tags": ["options", "layout", "quad"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }] },
    { "action": "log", "message": "Setting Quad layout" },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "Quad" } },
    { "action": "wait_frames", "count": 6 },
    { "action": "assert", "assertions": [{ "pane_count_equals": 4 }] },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 0, "kind": "Chart" } },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 1, "kind": "OptionsSentiment" } },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 2, "kind": "Chart" } },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 3, "kind": "OptionsFlow" } },
    { "action": "wait_frames", "count": 8 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "pane_count_equals": 4 },
      { "pane_type_equals": { "pane": 0, "type": "Chart" } },
      { "pane_type_equals": { "pane": 1, "type": "OptionsSentiment" } },
      { "pane_type_equals": { "pane": 2, "type": "Chart" } },
      { "pane_type_equals": { "pane": 3, "type": "OptionsFlow" } },
      { "no_active_violations": true }
    ] },
    { "action": "reset" }
  ]
}
