{
  "name": "layout_regression",
  "description": "Save a baseline widget-tree snapshot after reset, then verify a symbol switch doesn't break state or fps.",
  "tags": ["design", "regression", "layout"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    {
      "action": "snapshot",
      "name": "baseline_clean"
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "TSLA"
    },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "active_symbol_equals": "TSLA" },
        { "fps_above": 5.0 },
        { "no_active_violations": true }
      ]
    },
    {
      "action": "assert_layout",
      "assertions": [
        { "no_unintended_overlap": { "layer": 0 } }
      ]
    },
    {
      "action": "assert",
      "assertions": [
        { "all_touch_targets_ok": 24 },
        { "no_clipped_widgets": true },
        { "design_audit_clean": true }
      ]
    },
    {
      "action": "http_get",
      "path": "/layout-diff?baseline=baseline_clean"
    },
    { "action": "log", "message": "Layout regression scenario passed. Check /layout-diff?baseline=baseline_clean for geometry deltas." }
  ]
}
