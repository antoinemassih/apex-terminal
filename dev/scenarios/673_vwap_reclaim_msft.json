{
  "name": "vwap_reclaim_msft",
  "description": "Trade a MSFT VWAP reclaim on 5m with EMA confluence.",
  "story": "DayTrading/VwapReclaim",
  "tags": [
    "story",
    "daytrading",
    "msft",
    "vwap",
    "ema"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "MSFT VWAP reclaim setup on 5m with EMA confluence"
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "MSFT"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "ChangeTimeframe",
      "pane": 0,
      "tf": "5m"
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "pane": 0,
      "kind": "VWAP"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "AddIndicator",
      "pane": 0,
      "kind": "EMA"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "SetChartFlag",
      "pane": 0,
      "flag": "ShowVolume",
      "value": true
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "RecomputeIndicators",
      "pane": 0
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "assert",
      "assertions": [
        {
          "pane_symbol_equals": {
            "pane": 0,
            "symbol": "MSFT"
          }
        },
        {
          "canvas_indicator_exists": {
            "pane": 0,
            "kind": "VWAP"
          }
        },
        {
          "canvas_indicator_count_equals": {
            "pane": 0,
            "count": 2
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "canvas_all_finite": true
        },
        {
          "canvas_bars_monotonic": true
        },
        {
          "canvas_bars_screen_ordered": true
        },
        {
          "canvas_bar_ohlc_valid": {
            "pane": 0
          }
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}