{
  "name": "watchlist_section_title",
  "description": "Exercises watchlist_section_title_equals: adds two sections with distinct titles, asserts each title at its index.",
  "story": "Watchlist/TitleAssertion",
  "priority": 1,
  "tags": ["extension", "watchlist"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    { "action": "cmd", "cmd": "WatchlistAddSection", "args": { "title": "Tech Stocks" } },
    { "action": "cmd", "cmd": "WatchlistAddSection", "args": { "title": "ETF Watchlist" } },
    { "action": "wait_frames", "count": 2 },
    {
      "action": "assert",
      "assertions": [
        { "watchlist_section_count_equals": 3 },
        { "watchlist_section_title_equals": { "idx": 1, "title": "Tech Stocks" } },
        { "watchlist_section_title_equals": { "idx": 2, "title": "ETF Watchlist" } }
      ]
    },
    { "action": "reset" }
  ]
}
