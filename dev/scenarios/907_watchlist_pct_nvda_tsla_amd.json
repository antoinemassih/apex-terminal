{
  "name": "watchlist_pct_nvda_tsla_amd",
  "description": "Watchlist rows for ['NVDA', 'TSLA', 'AMD'] show a present, sane % change.",
  "story": "Watchlist/Pct",
  "tags": [
    "watchlist",
    "correctness"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "NVDA"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "TSLA"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "cmd",
      "cmd": "WatchlistAddSymbol",
      "symbol": "AMD"
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "wait",
      "ms": 2000
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "log",
      "message": "watchlist % ['NVDA', 'TSLA', 'AMD']"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "watchlist_pct_present": true
        },
        {
          "watchlist_pct_sane": 25.0
        },
        {
          "no_panic": true
        }
      ]
    }
  ]
}