{
  "name": "dialog_lifecycle_complete",
  "description": "Full dialog open/close lifecycle: open indicator editor on pane 0, verify dialog_open, close via CloseIndicatorEditor, verify dialog_closed. Then open and close via CloseAllDialogs.",
  "story": "UX/Dialogs",
  "tags": ["dialogs", "state-mutation"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [
      { "no_open_dialogs": true }
    ]},
    { "action": "log", "message": "Opening indicator editor on pane 0" },
    { "action": "cmd", "cmd": "OpenIndicatorEditor", "args": { "pane": 0 } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [
      { "dialog_open": "indicator_editor.0" }
    ]},
    { "action": "log", "message": "Closing via CloseIndicatorEditor" },
    { "action": "cmd", "cmd": "CloseIndicatorEditor", "args": { "pane": 0 } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [
      { "dialog_closed": "indicator_editor.0" },
      { "no_open_dialogs": true }
    ]},
    { "action": "log", "message": "Opening two indicator editors on panes 0 and 1 (needs TwoColumns)" },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "TwoColumns" } },
    { "action": "wait_frames", "count": 2 },
    { "action": "cmd", "cmd": "OpenIndicatorEditor", "args": { "pane": 0 } },
    { "action": "cmd", "cmd": "OpenIndicatorEditor", "args": { "pane": 1 } },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [
      { "dialog_open": "indicator_editor.0" },
      { "dialog_open": "indicator_editor.1" }
    ]},
    { "action": "log", "message": "CloseAllDialogs clears both at once" },
    { "action": "cmd", "cmd": "CloseAllDialogs", "args": {} },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [
      { "no_open_dialogs": true },
      { "fps_above": 5.0 }
    ]},
    { "action": "log", "message": "Restoring single-pane layout for clean handoff" },
    { "action": "reset" },
    { "action": "wait_frames", "count": 1 },
    { "action": "log", "message": "Dialog lifecycle fully verified" }
  ]
}
