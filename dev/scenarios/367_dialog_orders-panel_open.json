{
  "name": "dialog_orders_panel_open",
  "description": "Orders panel opens and reports dialog_open.",
  "story": "Dialog/Lifecycle",
  "tags": [
    "dialog"
  ],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "cmd",
      "cmd": "OpenOrdersPanel",
      "args": {}
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "assert",
      "assertions": [
        {
          "dialog_open": "orders_panel"
        },
        {
          "fps_above": 5
        }
      ]
    },
    {
      "action": "cmd",
      "cmd": "CloseOrdersPanel",
      "args": {}
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "reset"
    }
  ]
}