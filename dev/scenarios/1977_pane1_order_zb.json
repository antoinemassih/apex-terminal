{
  "name": "pane1_order_zb",
  "description": "ZB: order subsystem drives correctly on pane 1 (independence).",
  "story": "MultiPane/Order",
  "tags": [
    "multipane",
    "order",
    "independence"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 1,
      "symbol": "ZB"
    },
    {
      "action": "wait",
      "ms": 900
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SeedDraftOrder",
      "pane": 1,
      "side": "buy",
      "price": 100.0,
      "qty": 100
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "log",
      "message": "pane1 order ZB"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_gte": {
            "path": "panes.1.order_draft_count",
            "min": 1
          }
        },
        {
          "no_live_orders": true
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}