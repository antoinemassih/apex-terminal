{
  "name": "88_pane_type_mix_quad",
  "description": "Quad layout with all four different pane types: pane0=Chart, pane1=Dashboard, pane2=Portfolio, pane3=OptionsSentiment. Verify each and assert FPS.",
  "tags": ["pane", "types"],
  "settle_ms": 50,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 5 },
    { "action": "cmd", "cmd": "SetLayout", "args": { "layout": "Quad" } },
    { "action": "wait_frames", "count": 5 },
    { "action": "assert", "assertions": [ { "pane_count_equals": 4 } ] },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 0, "kind": "Chart" } },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 1, "kind": "Dashboard" } },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 2, "kind": "Portfolio" } },
    { "action": "cmd", "cmd": "ChangePaneType", "args": { "pane": 3, "kind": "OptionsSentiment" } },
    { "action": "wait_frames", "count": 10 },
    { "action": "assert", "assertions": [
      { "fps_above": 5.0 },
      { "pane_type_equals": { "pane": 0, "type": "Chart" } },
      { "pane_type_equals": { "pane": 1, "type": "Dashboard" } },
      { "pane_type_equals": { "pane": 2, "type": "Portfolio" } },
      { "pane_type_equals": { "pane": 3, "type": "OptionsSentiment" } },
      { "no_active_violations": true },
      { "no_clipped_widgets": true }
    ] }
  ]
}
