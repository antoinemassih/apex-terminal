{
  "name": "playbook_author_stamp",
  "description": "New plays are stamped with the local author handle; reset restores a clean baseline.",
  "story": "Playbook/Author",
  "tags": [
    "playbook",
    "author",
    "attribution"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SetAuthor",
      "handle": "quant_jane"
    },
    {
      "action": "wait_frames",
      "count": 1
    },
    {
      "action": "cmd",
      "cmd": "SeedPlay",
      "symbol": "GRAU",
      "long": true,
      "entry": 100.0,
      "target": 110.0,
      "stop": 95.0
    },
    {
      "action": "wait_frames",
      "count": 2
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "playbook.author",
            "value": "quant_jane"
          }
        },
        {
          "state_field_equals": {
            "path": "playbook.plays.0.author",
            "value": "quant_jane"
          }
        },
        {
          "no_panic": true
        }
      ]
    },
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "reset clears author baseline"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "playbook.author",
            "value": ""
          }
        }
      ]
    }
  ]
}