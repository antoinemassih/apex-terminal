{
  "name": "reset_iso_heatmap_es",
  "description": "After driving heatmap on ES, reset returns a clean baseline (no contamination).",
  "story": "Harness/ResetIsolation",
  "tags": [
    "harness",
    "reset",
    "isolation"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SwapPaneSymbol",
      "pane": 0,
      "symbol": "ES"
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SeedHeatmapCells",
      "count": 80
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "drive heatmap then reset ES"
    },
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 5
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "heatmap.cell_count",
            "value": 0
          }
        },
        {
          "no_panic": true
        },
        {
          "viewport_sane": true
        }
      ]
    }
  ]
}