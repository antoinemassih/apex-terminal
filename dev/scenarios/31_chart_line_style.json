{
  "name": "chart_line_style",
  "description": "Switch pane 0 to line chart type, verify stability, then return to candlestick.",
  "tags": ["chart", "style", "display"],
  "settle_ms": 30,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 2 },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "ChartType", "value": "Line" } },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "cmd", "cmd": "SetChartFlag", "args": { "pane": 0, "flag": "ChartType", "value": "Candlestick" } },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "fps_above": 5.0 }, { "no_active_violations": true }] },
    { "action": "log", "message": "Chart line style scenario passed." }
  ]
}
