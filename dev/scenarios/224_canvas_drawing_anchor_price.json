{
  "name": "canvas_drawing_anchor_price",
  "description": "Verify drawing anchor price is within tolerance of the commanded price",
  "story": "Canvas Introspection",
  "priority": 2,
  "tags": ["canvas", "drawings", "coordinates"],
  "steps": [
    {"action": "reset"},
    {"action": "wait", "ms": 30},
    {"action": "cmd", "cmd": "AddDrawing", "pane": 0,
     "id": "hl_anchor", "kind": "HorizLine", "price_a": 451.75},
    {"action": "wait", "ms": 30},
    {"action": "assert", "assertions": [
      {"canvas_drawing_anchor_price_near": {
        "pane": 0, "id": "hl_anchor", "anchor": 0,
        "price": 451.75, "tolerance": 0.01
      }},
      {"canvas_drawing_anchor_price_near": {
        "pane": 0, "id": "hl_anchor", "anchor": 0,
        "price": 451.00, "tolerance": 1.00
      }}
    ]}
  ]
}
