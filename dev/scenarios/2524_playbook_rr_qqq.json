{
  "name": "playbook_rr_qqq",
  "description": "Playbook QQQ short computes risk/reward 2.5 correctly.",
  "story": "Playbook/RiskReward",
  "tags": [
    "playbook",
    "riskreward",
    "correctness"
  ],
  "priority": 2,
  "settle_ms": 15,
  "abort_on_failure": false,
  "steps": [
    {
      "action": "reset"
    },
    {
      "action": "wait_frames",
      "count": 4
    },
    {
      "action": "cmd",
      "cmd": "SetPlaybookPanel",
      "open": true
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "cmd",
      "cmd": "SeedPlay",
      "symbol": "QQQ",
      "long": false,
      "entry": 350.0,
      "target": 335.0,
      "stop": 356.0
    },
    {
      "action": "wait_frames",
      "count": 3
    },
    {
      "action": "log",
      "message": "play QQQ rr=2.5"
    },
    {
      "action": "assert",
      "assertions": [
        {
          "state_field_equals": {
            "path": "playbook.open",
            "value": true
          }
        },
        {
          "state_field_equals": {
            "path": "playbook.play_count",
            "value": 1
          }
        },
        {
          "state_field_equals": {
            "path": "playbook.plays.0.risk_reward",
            "value": 2.5
          }
        },
        {
          "play_rr_correct": true
        },
        {
          "no_panic": true
        },
        {
          "fps_above": 5.0
        }
      ]
    }
  ]
}