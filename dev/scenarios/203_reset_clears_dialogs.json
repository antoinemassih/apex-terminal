{
  "name": "reset_clears_dialogs",
  "description": "Verify that POST /reset clears all open dialogs. Opens 3 dialogs (indicator_editor, order_entry, settings), then resets, asserts clean state.",
  "story": "Recovery/ResetClears",
  "priority": 1,
  "tags": ["reset", "dialogs", "recovery", "story"],
  "settle_ms": 0,
  "abort_on_failure": false,
  "steps": [
    { "action": "reset" },
    { "action": "wait_frames", "count": 2 },
    { "action": "assert", "assertions": [{ "open_dialog_count_equals": 0 }] },
    { "action": "cmd", "cmd": "OpenIndicatorEditor", "args": { "pane": 0, "id": 1 } },
    { "action": "cmd", "cmd": "OpenOrderEntry",      "args": {} },
    { "action": "cmd", "cmd": "OpenSettings",        "args": {} },
    { "action": "wait_frames", "count": 3 },
    { "action": "assert", "assertions": [{ "open_dialog_count_equals": 3 }] },
    { "action": "reset" },
    { "action": "wait_frames", "count": 3 },
    {
      "action": "assert",
      "assertions": [
        { "open_dialog_count_equals": 0 },
        { "no_open_dialogs": true },
        { "pane_count_equals": 1 },
        { "active_symbol_equals": "SPY" }
      ]
    }
  ]
}
